<Window x:Class="WebAPI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:local="clr-namespace:WebAPI"
        Title="WebAPI - AI Relay" Height="720" Width="1200"
        MinHeight="500" MinWidth="900"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDark}"
        Foreground="{StaticResource TextPrimary}">

    <Window.Resources>
        <ContextMenu x:Key="TrayMenu">
            <MenuItem Header="显示窗口" Click="Tray_Show_Click"/>
            <Separator/>
            <MenuItem Header="退出" Click="Tray_Exit_Click"/>
        </ContextMenu>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Enter" Modifiers="Ctrl" Command="{x:Static local:MainWindowCommands.SendMessageCommand}"/>
        <KeyBinding Key="Tab" Modifiers="Ctrl" Command="{x:Static local:MainWindowCommands.SwitchTabCommand}"/>
        <KeyBinding Key="F5" Command="{x:Static local:MainWindowCommands.RestartBrowserCommand}"/>
    </Window.InputBindings>

    <DockPanel>
        <!-- 系统托盘图标 -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        IconSource="logo.ico"
                        ToolTipText="WebAPI - AI Relay 代理服务"
                        LeftClickCommand="{x:Static local:MainWindowCommands.ToggleWindowCommand}"
                        DoubleClickCommand="{x:Static local:MainWindowCommands.ToggleWindowCommand}"
                        ContextMenu="{StaticResource TrayMenu}"/>

        <!-- 顶部:标签页栏 + 工具按钮 -->
        <DockPanel DockPanel.Dock="Top" Margin="8,4,8,0">
            <TabControl x:Name="ChannelTabs"
                        BorderThickness="0"
                        Background="Transparent"
                        SelectionChanged="ChannelTabs_SelectionChanged"/>
        </DockPanel>

        <!-- 底部:状态栏 -->
        <StatusBar DockPanel.Dock="Bottom" 
                    Height="28" MaxHeight="28" MinHeight="28"
                    Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource BorderGray}"
                    BorderThickness="0,1,0,0"
                    Foreground="{StaticResource TextSecondary}"
                    FontSize="12" Padding="6,0">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem Grid.Column="0">
                <StackPanel x:Name="ChannelStatusPanel" Orientation="Horizontal"/>
            </StatusBarItem>
            <Separator Grid.Column="1"/>
            <StatusBarItem Grid.Column="1">
                <TextBlock x:Name="StatusText" Text="就绪"/>
            </StatusBarItem>
            <Separator Grid.Column="2"/>
            <StatusBarItem Grid.Column="2">
                <TextBlock x:Name="StatusPorts" Text=""/>
            </StatusBarItem>
            <Separator Grid.Column="3"/>
            <StatusBarItem Grid.Column="3">
                <TextBlock x:Name="StatusRequests" Text="请求: 0"/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="4" HorizontalAlignment="Right">
                <TextBlock x:Name="StatusUptime" Text=""/>
            </StatusBarItem>
        </StatusBar>

        <!-- 中间内容区:由标签页控制 -->
    </DockPanel>

</Window>
