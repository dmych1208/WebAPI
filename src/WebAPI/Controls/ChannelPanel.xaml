<UserControl x:Class="WebAPI.Controls.ChannelPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Loaded="ChannelPanel_Loaded">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" MinWidth="280" MaxWidth="400" />
        </Grid.ColumnDefinitions>

        <!-- ========== 左侧：WebView2 + 输入栏 ========== -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- WebView2 区域 -->
            <Border Grid.Row="0" Background="#1A1A1A">
                <Grid>
                    <wv2:WebView2 x:Name="WebView" Visibility="Collapsed"/>
                    <!-- 占位提示 -->
                    <StackPanel x:Name="LoadingPlaceholder"
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center">
                        <ProgressBar x:Name="LoadingSpinner"
                                     Width="200" Height="4"
                                     IsIndeterminate="True"
                                     Background="Transparent"
                                     Foreground="{StaticResource AccentBlue}"
                                     BorderBrush="{StaticResource BorderGray}"
                                     Margin="0,0,0,12"/>
                        <TextBlock x:Name="PlaceholderText" 
                                   Text="正在初始化浏览器..." 
                                   HorizontalAlignment="Center" 
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="14"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 底部输入栏 -->
            <Border Grid.Row="1" Background="{StaticResource BgPanel}" 
                    Padding="10,8" BorderBrush="{StaticResource BorderGray}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 输入框 -->
                    <TextBox x:Name="InputBox" 
                             TextWrapping="Wrap" AcceptsReturn="True"
                             Height="44" VerticalScrollBarVisibility="Auto"
                             FontSize="13" Padding="12,10"
                             Background="{StaticResource BgInput}" 
                             Foreground="{StaticResource TextPrimary}"
                             BorderBrush="{StaticResource BorderGray}"
                             CaretBrush="{StaticResource TextPrimary}"
                             KeyDown="InputBox_KeyDown"/>

                    <!-- 按钮组 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Bottom">
                        <ToggleButton x:Name="BtnDeepThink" Content="🧠深度思考" 
                                      Padding="8,5" Margin="0,0,4,0"
                                      FontSize="11" Cursor="Hand"
                                      Background="Transparent" BorderBrush="{StaticResource BorderGray}"
                                      Foreground="{StaticResource TextSecondary}"
                                      Checked="BtnDeepThink_Checked" Unchecked="BtnDeepThink_Unchecked"/>
                        <ToggleButton x:Name="BtnSearch" Content="🔍智能搜索" 
                                      Padding="8,5" Margin="0,0,4,0"
                                      FontSize="11" Cursor="Hand"
                                      Background="Transparent" BorderBrush="{StaticResource BorderGray}"
                                      Foreground="{StaticResource TextSecondary}"
                                      Checked="BtnSearch_Checked" Unchecked="BtnSearch_Unchecked"/>
                        <Button x:Name="BtnSend" Content="⬆发送" 
                                Padding="10,5" FontSize="11" FontWeight="SemiBold" Cursor="Hand"
                                Background="{StaticResource AccentBlue}" BorderBrush="Transparent"
                                Foreground="White" Click="BtnSend_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ========== 右侧：控制面板 ========== -->
        <StackPanel Grid.Column="1" Background="{StaticResource BgPanel}" Margin="8,0,0,0">
            
            <!-- ① 渠道状态 -->
            <StackPanel Margin="0,8,0,8">
                <TextBlock x:Name="PanelTitle" FontSize="15" FontWeight="Bold" 
                           Foreground="{StaticResource AccentBlue}"/>
                <TextBlock x:Name="PanelStatus" FontSize="12" Margin="0,2,0,0"
                           Foreground="{StaticResource AccentGreen}"/>
            </StackPanel>

            <Separator Background="{StaticResource BorderGray}"/>

            <!-- ② API 信息 -->
            <StackPanel Margin="0,8,0,8">
                <!-- Base URL -->
                <TextBlock Text="Base URL (API地址):" FontSize="11" 
                           Foreground="{StaticResource TextSecondary}"/>
                <Grid Margin="0,3,0,0">
                    <TextBox x:Name="TxtBaseUrl" IsReadOnly="True" Height="26" Padding="4,3"
                             FontFamily="Consolas" FontSize="11"
                             Background="{StaticResource BgInput}" Foreground="{StaticResource TextPrimary}"
                             BorderBrush="{StaticResource BorderGray}" VerticalContentAlignment="Center"/>
                    <Button Content="复制" HorizontalAlignment="Right" Margin="0,2,2,2" Padding="6,2"
                            FontSize="10" Background="Transparent" BorderBrush="{StaticResource BorderGray}"
                            Foreground="{StaticResource TextSecondary}" Click="BtnCopyBaseUrl_Click"/>
                </Grid>

                <!-- API Key -->
                <TextBlock Text="API Key (任意填写):" FontSize="11" Margin="0,6,0,0"
                           Foreground="{StaticResource TextSecondary}"/>
                <Grid Margin="0,3,0,0">
                    <TextBox x:Name="TxtApiKey" IsReadOnly="True" Height="26" Padding="4,3"
                             FontFamily="Consolas" FontSize="11"
                             Background="{StaticResource BgInput}" Foreground="{StaticResource TextPrimary}"
                             BorderBrush="{StaticResource BorderGray}" VerticalContentAlignment="Center"/>
                    <Button Content="复制" HorizontalAlignment="Right" Margin="0,2,2,2" Padding="6,2"
                            FontSize="10" Background="Transparent" BorderBrush="{StaticResource BorderGray}"
                            Foreground="{StaticResource TextSecondary}" Click="BtnCopyApiKey_Click"/>
                </Grid>
            </StackPanel>

            <Separator Background="{StaticResource BorderGray}"/>

            <!-- ③ 可用模型组合 -->
            <StackPanel Margin="0,8,0,8">
                <TextBlock Text="📋 可用模型组合 (点击框体复制):" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBlue}"/>
                
                <!-- 模型列表动态生成 -->
                <ItemsControl x:Name="ModelList" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11" 
                                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" IsReadOnly="True" Text="{Binding Id}" Height="24" Margin="4,0,0,0"
                                         FontFamily="Consolas" FontSize="10" Padding="4,2"
                                         Background="{StaticResource BgInput}" Foreground="{StaticResource TextPrimary}"
                                         BorderBrush="{StaticResource BorderGray}" VerticalContentAlignment="Center"
                                         MouseLeftButtonDown="ModelId_MouseLeftButtonDown"/>
                                <Button Grid.Column="2" Content="复制" Padding="5,1" Margin="2,0,0,0"
                                        FontSize="9" Background="Transparent" BorderBrush="{StaticResource BorderGray}"
                                        Foreground="{StaticResource TextSecondary}" Click="BtnCopyModel_Click"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Separator Background="{StaticResource BorderGray}"/>

            <!-- ④ 实时日志 -->
            <StackPanel Margin="0,8,0,8">
                <TextBlock Text="📝 实时日志:" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBlue}"/>
                <TextBox x:Name="LogBox" IsReadOnly="True" 
                         Height="180" Margin="0,4,0,0"
                         FontFamily="Consolas" FontSize="10.5"
                         Background="{StaticResource BgLog}" 
                         Foreground="{StaticResource TextPrimary}"
                         BorderBrush="{StaticResource BorderGray}"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"/>
            </StackPanel>

            <!-- ⑤ 操作按钮 -->
            <StackPanel Margin="0,0,0,8">
                <Button x:Name="BtnRestartBrowser" Content="🔄 重启浏览器内核" Height="32"
                        FontSize="12" Cursor="Hand"
                        Background="{StaticResource AccentBlue}" BorderBrush="Transparent"
                        Foreground="White" Click="BtnRestartBrowser_Click" Margin="0,0,0,4"/>
                <Button x:Name="BtnStopService" Content="⏹ 停止 HTTP 服务" Height="32"
                        FontSize="12" Cursor="Hand"
                        Background="{StaticResource AccentRed}" BorderBrush="Transparent"
                        Foreground="White" Click="BtnStopService_Click"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</UserControl>
