<Window x:Class="WebAPI.Controls.ProxyConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🛡 代理配置" Height="520" Width="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        Background="{StaticResource BgDark}"
        Foreground="{StaticResource TextPrimary}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="代理设置（仅国外网站生效）" FontSize="14" FontWeight="Bold"
                       Foreground="{StaticResource AccentBlue}"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="启用代理:" FontSize="12"
                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
            <ToggleButton x:Name="ToggleEnabled" Grid.Column="1" Margin="8,0,0,0"
                          HorizontalAlignment="Left" Width="44" Height="22"
                          IsChecked="False"
                          Checked="ToggleEnabled_Changed"
                          Unchecked="ToggleEnabled_Changed">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="SwitchBorder" CornerRadius="11"
                                            Background="#555" Width="44" Height="22"
                                            Cursor="Hand">
                                        <Ellipse x:Name="Thumb" Fill="White" Width="18" Height="18"
                                                 HorizontalAlignment="Left" Margin="2,0,0,0"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="SwitchBorder" Property="Background" Value="#4EC9B0"/>
                                            <Setter TargetName="Thumb" Property="Margin" Value="24,0,0,0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>
            <TextBlock Grid.Column="2" x:Name="TxtProxyStatus" Text="已关闭" FontSize="11"
                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="代理模式:" FontSize="12"
                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
            <ComboBox x:Name="CmbMode" Grid.Column="1" Width="200" Margin="8,0,0,0" Height="26"
                      FontSize="12"
                      Background="{StaticResource BgInput}" Foreground="{StaticResource TextPrimary}"
                      BorderBrush="{StaticResource BorderGray}"
                      SelectionChanged="CmbMode_SelectionChanged">
                <ComboBoxItem Tag="bypass_cn" Content="🌏 绕过中国大陆"/>
                <ComboBoxItem Tag="global" Content="🌐 全局模式"/>
            </ComboBox>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="📡 代理节点列表:" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource AccentBlue}" VerticalAlignment="Center"/>
            <Button Content="📋 从剪贴板粘贴" Margin="12,0,0,0" Padding="8,3"
                    FontSize="11" Cursor="Hand"
                    Background="Transparent" BorderBrush="{StaticResource AccentBlue}"
                    Foreground="{StaticResource AccentBlue}"
                    Click="BtnPasteFromClipboard_Click"/>
            <Button Content="⚡ 一键测速" Margin="8,0,0,0" Padding="8,3"
                    FontSize="11" Cursor="Hand"
                    Background="Transparent" BorderBrush="{StaticResource AccentGreen}"
                    Foreground="{StaticResource AccentGreen}"
                    Click="BtnSpeedTestAll_Click"/>
        </StackPanel>

        <ListView x:Name="NodeListView" Grid.Row="4"
                  Background="{StaticResource BgInput}" Foreground="{StaticResource TextPrimary}"
                  BorderBrush="{StaticResource BorderGray}"
                  SelectionMode="Single"
                  MouseDoubleClick="NodeListView_MouseDoubleClick"
                  PreviewKeyDown="NodeListView_KeyDown">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="●" Width="16" FontSize="10"
                                   VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter Property="Foreground" Value="#4EC9B0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Grid.Column="1" Text="{Binding Type}" FontSize="10" Width="52"
                                   Foreground="{StaticResource AccentBlue}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="12" Margin="4,0,0,0"
                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" FontSize="10" Width="70"
                                   Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding Latency, StringFormat='{}{0}ms'}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Latency}" Value="-1">
                                            <Setter Property="Text" Value="--"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Grid.Column="4" Content="测速" Padding="6,1" Margin="4,0,2,0"
                                FontSize="10" Cursor="Hand"
                                Background="Transparent" BorderBrush="{StaticResource BorderGray}"
                                Foreground="{StaticResource AccentGreen}"
                                Click="BtnNodeSpeedTest_Click"/>
                        <Button Grid.Column="5" Content="✕" Padding="6,1" Margin="2,0,0,0"
                                FontSize="10" Cursor="Hand"
                                Background="Transparent" BorderBrush="Transparent"
                                Foreground="{StaticResource AccentRed}"
                                Click="BtnDeleteNode_Click"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="保存" Width="70" Height="30" Margin="0,0,8,0"
                    FontSize="12" Cursor="Hand"
                    Background="{StaticResource AccentBlue}" BorderBrush="Transparent"
                    Foreground="White" Click="BtnSave_Click"/>
            <Button Content="取消" Width="70" Height="30"
                    FontSize="12" Cursor="Hand"
                    Background="Transparent" BorderBrush="{StaticResource BorderGray}"
                    Foreground="{StaticResource TextSecondary}" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>