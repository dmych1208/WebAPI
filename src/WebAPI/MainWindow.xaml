<Window x:Class="WebAPI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:local="clr-namespace:WebAPI"
        Title="WebAPI - AI Relay" Height="720" Width="1200"
        MinHeight="500" MinWidth="900"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDark}"
        Foreground="{StaticResource TextPrimary}">

    <Window.Resources>
        <ContextMenu x:Key="TrayMenu">
            <MenuItem Header="显示窗口" Click="Tray_Show_Click"/>
            <Separator/>
            <MenuItem Header="退出" Click="Tray_Exit_Click"/>
        </ContextMenu>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Enter" Modifiers="Ctrl" Command="{x:Static local:MainWindowCommands.SendMessageCommand}"/>
        <KeyBinding Key="Tab" Modifiers="Ctrl" Command="{x:Static local:MainWindowCommands.SwitchTabCommand}"/>
        <KeyBinding Key="F5" Command="{x:Static local:MainWindowCommands.RestartBrowserCommand}"/>
    </Window.InputBindings>

    <DockPanel>
        <!-- 系统托盘图标 -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        IconSource="logo.ico"
                        ToolTipText="WebAPI - AI Relay 代理服务"
                        LeftClickCommand="{x:Static local:MainWindowCommands.ShowWindowCommand}"
                        ContextMenu="{StaticResource TrayMenu}"/>

        <!-- 底部：状态栏（固定高度28px） -->
        <Grid DockPanel.Dock="Bottom" Height="28" MaxHeight="28" MinHeight="28"
              Background="{StaticResource BgPanel}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="StatusText" Text="就绪"
                       FontSize="12" Foreground="{StaticResource TextSecondary}"
                       VerticalAlignment="Center" Margin="8,0,4,0"/>
            <Separator Grid.Column="1"/>
            <StackPanel Grid.Column="2" x:Name="ChannelStatusPanel" Orientation="Horizontal"
                        VerticalAlignment="Center"/>
            <TextBlock Grid.Column="3" x:Name="StatusRequests" Text="请求: 0"
                       FontSize="12" Foreground="{StaticResource TextSecondary}"
                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
            <TextBlock Grid.Column="4" x:Name="StatusUptime" Text=""
                       FontSize="12" Foreground="{StaticResource TextSecondary}"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
        </Grid>

        <!-- 主内容区 -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- TabControl 仅用于标签头 -->
            <TabControl x:Name="ChannelTabs" Grid.Row="0"
                        BorderThickness="0" 
                        Background="Transparent"
                        Margin="8,4,8,0"
                        Padding="0"
                        SelectionChanged="ChannelTabs_SelectionChanged"/>
            <!-- 内容区：所有面板始终在可视化树中 -->
            <Grid x:Name="ContentGrid" Grid.Row="1" Margin="8,0,8,0"/>
        </Grid>
    </DockPanel>

</Window>
