<Window x:Class="WebAPI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:local="clr-namespace:WebAPI"
        Title="WebAPI - AI Relay" Height="720" Width="1200"
        MinHeight="500" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDark}"
        Foreground="{StaticResource TextPrimary}">

    <Window.Resources>
        <ContextMenu x:Key="TrayMenu">
            <MenuItem Header="显示窗口" Click="Tray_Show_Click"/>
            <Separator/>
            <MenuItem Header="退出" Click="Tray_Exit_Click"/>
        </ContextMenu>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Enter" Modifiers="Ctrl" Command="{x:Static local:MainWindowCommands.SendMessageCommand}"/>
        <KeyBinding Key="Tab" Modifiers="Ctrl" Command="{x:Static local:MainWindowCommands.SwitchTabCommand}"/>
        <KeyBinding Key="F5" Command="{x:Static local:MainWindowCommands.RestartBrowserCommand}"/>
    </Window.InputBindings>

    <DockPanel>
        <!-- 系统托盘图标 -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        IconSource="logo.ico"
                        ToolTipText="WebAPI - AI Relay 代理服务"
                        LeftClickCommand="{x:Static local:MainWindowCommands.SwitchTabCommand}"
                        ContextMenu="{StaticResource TrayMenu}"/>

        <!-- 顶部：标签页栏 + 工具按钮 -->
        <DockPanel DockPanel.Dock="Top" Margin="8,4,8,0">
            <TabControl x:Name="ChannelTabs" 
                        BorderThickness="0" 
                        Background="Transparent"
                        SelectionChanged="ChannelTabs_SelectionChanged"/>
        </DockPanel>

        <!-- 底部：状态栏 -->
        <StatusBar DockPanel.Dock="Bottom" 
                    Background="{StaticResource BgPanel}" 
                    BorderBrush="{StaticResource BorderGray}"
                    Foreground="{StaticResource TextSecondary}"
                    FontSize="12" Padding="4,2">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="就绪"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="StatusPorts" Text=""/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="StatusRequests" Text="请求: 0"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="StatusUptime" Text=""/>
            </StatusBarItem>
        </StatusBar>

        <!-- 中间内容区：由标签页控制 -->
    </DockPanel>

</Window>
