    {
      "StepRunnerKey": "sys:csscript",
      "InputParams": {
        "mode": {
          "VarKey": null,
          "Value": "normal_roslyn"
        },
        "script": {
          "VarKey": null,
          "Value": "//css_ref System.Windows.Forms.dll\r\n//css_ref System.Drawing.dll\r\n//css_ref Microsoft.Web.WebView2.Core.dll\r\n\r\nusing System;\r\nusing System.IO;\r\nusing System.Net;\r\nusing System.Text;\r\nusing System.Threading.Tasks;\r\nusing System.Collections.Generic;\r\nusing System.Linq;\r\nusing System.Text.RegularExpressions;\r\nusing System.Windows.Forms;\r\nusing System.Drawing;\r\nusing Microsoft.Web.WebView2.Core;\r\n\r\npublic static void Exec(Quicker.Public.IStepContext context)\r\n{\r\n    // 1. 线程检查\r\n    if (System.Threading.Thread.CurrentThread.GetApartmentState() != System.Threading.ApartmentState.STA)\r\n    {\r\n        MessageBox.Show(\"配置错误：\\n请将模块【执行线程】设置为 【后台线程 (STA独立线程) / staLongRun】\", \"Doubao Relay\");\r\n        return;\r\n    }\r\n\r\n    // 2. 参数读取\r\n    string inputParam = \"\";\r\n    try {\r\n        inputParam = context.GetVarValue(\"input\") as string;\r\n    } catch { }\r\n    \r\n    inputParam = inputParam?.Trim().ToLower() ?? \"\";\r\n\r\n    if (inputParam == \"shutdown\" || inputParam == \"stop\")\r\n    {\r\n        ShutdownRemoteService();\r\n        return; \r\n    }\r\n\r\n    bool isSilent = inputParam == \"silent\";\r\n\r\n    // 3. 启动\r\n    Application.EnableVisualStyles();\r\n    Application.SetCompatibleTextRenderingDefault(false);\r\n    DoubaoForm form = new DoubaoForm(isSilent);\r\n    Application.Run(form); \r\n}\r\n\r\nprivate static void ShutdownRemoteService()\r\n{\r\n    try \r\n    {\r\n        var request = WebRequest.Create(\"http://127.0.0.1:56666/shutdown\");\r\n        request.Timeout = 2000; \r\n        using(var response = request.GetResponse()) { }\r\n        MessageBox.Show(\"✅ 已发送停止指令。\", \"Doubao Relay\");\r\n    }\r\n    catch { MessageBox.Show(\"⚠️ 连接服务失败。\", \"错误\"); }\r\n}\r\n\r\npublic class DoubaoForm : Form\r\n{\r\n    private readonly bool _isDebugMode; \r\n    private const string TargetUrl = \"https://www.doubao.com/chat/\";\r\n    private const int ServerPort = 56666;  \r\n    private readonly string _userDataFolder = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments), \"Doubao_Quicker_Data\");\r\n    private const string IconUrl = \"https://lf-cdn.doubao.com/obj/static-resource/byted-chat-doubao/favicon.ico\";\r\n\r\n    private CoreWebView2Environment _env;\r\n    private CoreWebView2Controller _controller;\r\n    private CoreWebView2 _coreWebView;\r\n\r\n    private TextBox _txtLog;\r\n    private Button _btnToggle;\r\n    private Label _lblStatus;\r\n    private Panel _rightPanel;\r\n    private Panel _webPanel; \r\n    \r\n    private NotifyIcon _notifyIcon;\r\n    private ContextMenuStrip _trayMenu;\r\n\r\n    private HttpListener _httpListener;\r\n    private HttpListenerContext _currentContext;\r\n    private bool _isCurrentRequestStreaming;\r\n    private StringBuilder _networkBuffer = new StringBuilder();\r\n    private StringBuilder _plainResponseBuffer = new StringBuilder(); // 非流式聚合文本\r\n    private string _lastEventType = \"\";\r\n    private bool _hasSeenUserMessage = false;  // 标记是否已经看到用户消息\r\n    private bool _hasProcessedImage = false;  // 标记是否已经处理过图片\r\n    private bool _isImageGenerationPending = false;  // 标记是否正在等待图片URL\r\n    private List<string> _pendingImageUrls = new List<string>();  // 存储待处理的图片URL\r\n    private HashSet<string> _sentImageUrls = new HashSet<string>();  // 记录已发送/处理的图片URL，避免重复\r\n    private string _thinkingBlockId = \"\"; // 记录当前思考块的ID\r\n    private bool _isThinkingActive = false; // 是否处于思考状态\r\n    private bool _isCurrentBlockThinking = false; // 当前活跃块是否为思考块\r\n    private bool _isHiddenMode = false;\r\n    private bool _isInitializing = false;\r\n\r\n    public DoubaoForm(bool isSilent)\r\n    {\r\n        _isDebugMode = !isSilent; \r\n        InitializeComponent();\r\n        InitializeSystemTray(); \r\n        \r\n        this.Load += async (s, e) => {\r\n            await LoadCustomIconAsync();\r\n            await InitializeCoreWebView2Async();\r\n        };\r\n        this.Resize += (s, e) => {\r\n            if (!_isHiddenMode) ResizeWebView();\r\n        };\r\n        \r\n        StartHttpServer(); \r\n    }\r\n\r\n    private void InitializeSystemTray()\r\n    {\r\n        _trayMenu = new ContextMenuStrip();\r\n        _trayMenu.Items.Add(\"显示/隐藏控制台\", null, (s, e) => ToggleWindowVisibility());\r\n        _trayMenu.Items.Add(\"重启浏览器内核\", null, async (s, e) => await RestartCoreWebView2Async());\r\n        _trayMenu.Items.Add(new ToolStripSeparator());\r\n        _trayMenu.Items.Add(\"退出服务\", null, (s, e) => this.Close());\r\n\r\n        _notifyIcon = new NotifyIcon();\r\n        _notifyIcon.Text = \"Doubao Relay Service (56666)\";\r\n        _notifyIcon.Icon = SystemIcons.Application;\r\n        _notifyIcon.ContextMenuStrip = _trayMenu;\r\n        _notifyIcon.Visible = true;\r\n        _notifyIcon.DoubleClick += (s, e) => ToggleWindowVisibility();\r\n    }\r\n\r\n    private async Task LoadCustomIconAsync()\r\n    {\r\n        try {\r\n            using (var client = new WebClient())\r\n            {\r\n                byte[] data = await client.DownloadDataTaskAsync(IconUrl);\r\n                using (var ms = new MemoryStream(data))\r\n                using (var bmp = new Bitmap(ms))\r\n                {\r\n                    var icon = Icon.FromHandle(bmp.GetHicon());\r\n                    this.Icon = icon;\r\n                    _notifyIcon.Icon = icon;\r\n                }\r\n            }\r\n        } catch { /* 图标下载失败忽略 */ }\r\n    }\r\n\r\n    private async Task RestartCoreWebView2Async()\r\n    {\r\n        Log(\"♻️ 正在重启浏览器内核...\");\r\n        if (_coreWebView != null) {\r\n            try { _coreWebView.Stop(); } catch { }\r\n        }\r\n        if (_controller != null) {\r\n            try { _controller.Close(); } catch { }\r\n            _controller = null;\r\n        }\r\n        _coreWebView = null;\r\n        _env = null;\r\n        _isInitializing = false;\r\n        await Task.Delay(1000);\r\n        await InitializeCoreWebView2Async();\r\n        \r\n        // 如果是在隐藏模式下重启，确保控制器也是可见的（以便在后台运行）\r\n        if (_isHiddenMode && _controller != null) {\r\n            try { _controller.IsVisible = true; } catch { }\r\n        }\r\n    }\r\n\r\n    private void ToggleWindowVisibility()\r\n    {\r\n        if (_isHiddenMode)\r\n        {\r\n            _isHiddenMode = false;\r\n            if (this.Left < -10000) this.CenterToScreen();\r\n            this.ShowInTaskbar = true;\r\n            this.WindowState = FormWindowState.Normal;\r\n            \r\n            try {\r\n                if (_controller != null) _controller.IsVisible = true;\r\n            } catch {\r\n                Log(\"⚠️ 句柄失效，正在重建...\");\r\n                Task.Run(() => this.Invoke(new Action(async () => await RestartCoreWebView2Async())));\r\n            }\r\n\r\n            ResizeWebView(); \r\n            this.BringToFront();\r\n            this.Activate();\r\n        }\r\n        else\r\n        {\r\n            _isHiddenMode = true;\r\n            this.ShowInTaskbar = false;\r\n            this.Location = new Point(-32000, -32000);\r\n        }\r\n    }\r\n\r\n    private void InitializeComponent()\r\n    {\r\n        this.Text = $\"Doubao Relay (Port: {ServerPort})\";\r\n        this.Size = new Size(1200, 800);\r\n        this.StartPosition = FormStartPosition.CenterScreen;\r\n        this.BackColor = Color.FromArgb(30, 30, 30);\r\n        this.FormBorderStyle = FormBorderStyle.Sizable; \r\n\r\n        if (_isDebugMode)\r\n        {\r\n            this.ShowInTaskbar = true;\r\n            _isHiddenMode = false;\r\n        }\r\n        else\r\n        {\r\n            this.ShowInTaskbar = false;\r\n            this.StartPosition = FormStartPosition.Manual;\r\n            this.Location = new Point(-32000, -32000);\r\n            _isHiddenMode = true;\r\n        }\r\n\r\n        var split = new SplitContainer();\r\n        split.Dock = DockStyle.Fill;\r\n        split.Orientation = Orientation.Vertical;\r\n        split.SplitterDistance = (int)(this.Width * 0.7); \r\n        split.BackColor = Color.FromArgb(45, 45, 48);\r\n        this.Controls.Add(split);\r\n\r\n        _webPanel = new Panel();\r\n        _webPanel.Dock = DockStyle.Fill;\r\n        _webPanel.BackColor = Color.Black;\r\n        split.Panel1.Controls.Add(_webPanel);\r\n        _webPanel.Resize += (s, e) => ResizeWebView();\r\n\r\n        _rightPanel = split.Panel2;\r\n        _rightPanel.Padding = new Padding(10);\r\n        _rightPanel.BackColor = Color.FromArgb(30, 30, 30);\r\n\r\n        var btnPanel = new Panel();\r\n        btnPanel.Dock = DockStyle.Bottom;\r\n        btnPanel.Height = 125; \r\n        btnPanel.BackColor = Color.Transparent;\r\n\r\n        var btnHost = new Button();\r\n        btnHost.Text = \"🚀 进入一键托管 (隐藏)\";\r\n        btnHost.Height = 35;\r\n        btnHost.Dock = DockStyle.Top;\r\n        btnHost.BackColor = Color.MediumPurple;\r\n        btnHost.ForeColor = Color.White;\r\n        btnHost.FlatStyle = FlatStyle.Flat;\r\n        btnHost.Click += (s, e) => {\r\n            if (!_isHiddenMode) ToggleWindowVisibility();\r\n            Log(\"已切换至托管模式\");\r\n        };\r\n\r\n        var btnRestart = new Button();\r\n        btnRestart.Text = \"🔄 重启浏览器内核\";\r\n        btnRestart.Height = 35;\r\n        btnRestart.Dock = DockStyle.Top;\r\n        btnRestart.BackColor = Color.SteelBlue;\r\n        btnRestart.ForeColor = Color.White;\r\n        btnRestart.FlatStyle = FlatStyle.Flat;\r\n        btnRestart.Click += async (s, e) => await RestartCoreWebView2Async();\r\n\r\n        _btnToggle = new Button();\r\n        _btnToggle.Text = \"停止 HTTP 服务\";\r\n        _btnToggle.Height = 35;\r\n        _btnToggle.Dock = DockStyle.Bottom;\r\n        _btnToggle.BackColor = Color.IndianRed;\r\n        _btnToggle.ForeColor = Color.White;\r\n        _btnToggle.FlatStyle = FlatStyle.Flat;\r\n        _btnToggle.Click += (s, e) => ToggleService();\r\n        \r\n        btnPanel.Controls.Add(btnRestart);\r\n        btnPanel.Controls.Add(new Panel { Height = 5, Dock = DockStyle.Top }); // 间距\r\n        btnPanel.Controls.Add(btnHost);\r\n        btnPanel.Controls.Add(_btnToggle);\r\n        _rightPanel.Controls.Add(btnPanel);\r\n\r\n        var infoPanel = new Panel();\r\n        infoPanel.Height = 220;\r\n        infoPanel.Dock = DockStyle.Top;\r\n        \r\n        var lblTitle = new Label { Text = \"Doubao Relay\", Font = new Font(\"Microsoft YaHei\", 14, FontStyle.Bold), ForeColor = Color.FromArgb(102, 153, 255), AutoSize = true, Location = new Point(0, 0) };\r\n        infoPanel.Controls.Add(lblTitle);\r\n\r\n        _lblStatus = new Label { Text = \"✅ Doubao Relay 正在运行\", ForeColor = Color.LightGreen, AutoSize = true, Location = new Point(0, 40) };\r\n        infoPanel.Controls.Add(_lblStatus);\r\n\r\n        infoPanel.Controls.Add(CreateLabel(\"豆包 (Doubao) API 地址:\", 70));\r\n        infoPanel.Controls.Add(CreateTextBox($\"http://127.0.0.1:{ServerPort}\", 90));\r\n        infoPanel.Controls.Add(CreateLabel(\"兼容端点:\", 120));\r\n        infoPanel.Controls.Add(CreateTextBox(\"/v1/chat/completions\", 140));\r\n        infoPanel.Controls.Add(CreateLabel(\"核心版本:\", 170));\r\n        infoPanel.Controls.Add(CreateTextBox(\"V1.15 (Final Stable Edition)\", 190));\r\n\r\n        _rightPanel.Controls.Add(infoPanel);\r\n\r\n        _txtLog = new TextBox();\r\n        _txtLog.Multiline = true;\r\n        _txtLog.ScrollBars = ScrollBars.Vertical;\r\n        _txtLog.Dock = DockStyle.Fill;\r\n        _txtLog.BackColor = Color.FromArgb(45, 45, 48);\r\n        _txtLog.ForeColor = Color.Gainsboro;\r\n        _txtLog.ReadOnly = true;\r\n        _txtLog.BorderStyle = BorderStyle.FixedSingle;\r\n        \r\n        var logContainer = new Panel();\r\n        logContainer.Dock = DockStyle.Fill;\r\n        logContainer.Padding = new Padding(0, 10, 0, 10);\r\n        logContainer.Controls.Add(_txtLog);\r\n        _rightPanel.Controls.Add(logContainer);\r\n        \r\n        logContainer.BringToFront();\r\n    }\r\n\r\n    private Label CreateLabel(string text, int y) {\r\n        return new Label { Text = text, ForeColor = Color.Gray, Location = new Point(0, y), AutoSize = true };\r\n    }\r\n    private TextBox CreateTextBox(string text, int y) {\r\n        return new TextBox { Text = text, ReadOnly = true, BackColor = Color.FromArgb(30,30,30), ForeColor = Color.White, Location = new Point(0, y), Width = 280, BorderStyle = BorderStyle.None };\r\n    }\r\n\r\n    private async Task InitializeCoreWebView2Async()\r\n    {\r\n        try {\r\n            _env = await CoreWebView2Environment.CreateAsync(null, _userDataFolder);\r\n            _controller = await _env.CreateCoreWebView2ControllerAsync(_webPanel.Handle);\r\n            \r\n            // 重要：即使窗口在屏幕外/隐藏，控制器也必须设为可见，否则 WebView2 可能会挂起加载逻辑\r\n            _controller.IsVisible = true; \r\n            \r\n            _coreWebView = _controller.CoreWebView2;\r\n            ResizeWebView();\r\n\r\n            await _coreWebView.AddScriptToExecuteOnDocumentCreatedAsync(GetNetworkInterceptorScript());\r\n            _coreWebView.WebMessageReceived += OnWebMessageReceived;\r\n            _coreWebView.NavigationCompleted += async (s, e) => {\r\n                if (e.IsSuccess) {\r\n                    await _coreWebView.ExecuteScriptAsync(GetDomControlScript());\r\n                    Log(\"系统就绪！\"); \r\n                    if (_isDebugMode) ShowToast(); \r\n                }\r\n            };\r\n            _coreWebView.Navigate(TargetUrl);\r\n        } catch (Exception ex) { Log($\"CoreWebView2 初始化失败: {ex.Message}\"); }\r\n    }\r\n\r\n    private void ResizeWebView()\r\n    {\r\n        if (_controller != null && !_webPanel.IsDisposed && _webPanel.IsHandleCreated)\r\n        {\r\n            try {\r\n                _controller.Bounds = new Rectangle(0, 0, _webPanel.Width, _webPanel.Height);\r\n            } catch { }\r\n        }\r\n    }\r\n\r\n    protected override void OnFormClosing(FormClosingEventArgs e)\r\n    {\r\n        StopHttpServer();\r\n        if (_notifyIcon != null) {\r\n            _notifyIcon.Visible = false;\r\n            _notifyIcon.Dispose();\r\n        }\r\n        base.OnFormClosing(e);\r\n    }\r\n\r\n    private void ToggleService()\r\n    {\r\n        if (_httpListener != null && _httpListener.IsListening) {\r\n            StopHttpServer(); Log(\"服务已停止\"); \r\n            _btnToggle.Text = \"启动 HTTP 服务\"; _btnToggle.BackColor = Color.SeaGreen;\r\n            _lblStatus.Text = \"⏹ 已停止\"; _lblStatus.ForeColor = Color.Gray;\r\n        } else {\r\n            StartHttpServer(); Log(\"服务已启动\"); \r\n            _btnToggle.Text = \"停止 HTTP 服务\"; _btnToggle.BackColor = Color.IndianRed;\r\n            _lblStatus.Text = \"✅ 正在运行\"; _lblStatus.ForeColor = Color.LightGreen;\r\n        }\r\n    }\r\n\r\n    private void StartHttpServer()\r\n    {\r\n        try {\r\n            if (_httpListener != null) StopHttpServer(); \r\n            _httpListener = new HttpListener();\r\n            _httpListener.Prefixes.Add($\"http://127.0.0.1:{ServerPort}/\");\r\n            _httpListener.Start();\r\n            Task.Run(ListenLoop);\r\n            Log($\"HTTP 服务监听中: {ServerPort}\");\r\n        } catch (Exception ex) { Log($\"HTTP 启动失败: {ex.Message}\"); }\r\n    }\r\n\r\n    private void StopHttpServer()\r\n    {\r\n        try { if (_httpListener != null) { _httpListener.Stop(); _httpListener.Close(); _httpListener = null; } } catch { }\r\n    }\r\n\r\n    private async Task ListenLoop()\r\n    {\r\n        var listener = _httpListener;\r\n        if (listener == null) return;\r\n        while (listener != null && listener.IsListening) {\r\n            try { var context = await listener.GetContextAsync(); HandleRequest(context); } catch { break; }\r\n        }\r\n    }\r\n\r\n    private void HandleRequest(HttpListenerContext ctx)\r\n    {\r\n        string path = ctx.Request.Url.AbsolutePath.ToLower();\r\n        string method = ctx.Request.HttpMethod.ToUpper();\r\n        ctx.Response.AppendHeader(\"Access-Control-Allow-Origin\", \"*\");\r\n        ctx.Response.AppendHeader(\"Access-Control-Allow-Headers\", \"Content-Type, Authorization\");\r\n\r\n        if (method == \"OPTIONS\") { ctx.Response.StatusCode = 200; ctx.Response.Close(); return; }\r\n\r\n        if (path == \"/shutdown\") {\r\n            ResponseText(ctx, \"Closing...\");\r\n            this.Invoke(new Action(() => {\r\n                Task.Delay(1000).ContinueWith(_ => this.Invoke(new Action(() => this.Close())));\r\n            }));\r\n            return;\r\n        }\r\n\r\n        // 处理 /v1/models 端点\r\n        if (path == \"/v1/models\" && method == \"GET\") {\r\n            string modelsJson = @\"{\r\n                \"\"data\"\": [\r\n                    {\r\n                        \"\"id\"\": \"\"doubao-chat\"\",\r\n                        \"\"object\"\": \"\"model\"\",\r\n                        \"\"created\"\": 1626777600,\r\n                        \"\"owned_by\"\": \"\"bytedance\"\",\r\n                        \"\"supported_endpoint_types\"\": [\r\n                            \"\"openai\"\"\r\n                        ]\r\n                    }\r\n                ],\r\n                \"\"object\"\": \"\"list\"\",\r\n                \"\"success\"\": true\r\n            }\";\r\n            ResponseText(ctx, modelsJson, 200, \"application/json\");\r\n            return;\r\n        }\r\n\r\n        if ((path == \"/v1/chat/completions\" || path == \"/chat\") && method == \"POST\")\r\n        {\r\n            if (_currentContext != null) { ResponseText(ctx, \"{\\\"error\\\": \\\"Busy\\\"}\", 429, \"application/json\"); return; }\r\n            try {\r\n                using (var reader = new StreamReader(ctx.Request.InputStream, Encoding.UTF8)) {\r\n                    string body = reader.ReadToEnd();\r\n                    Log(\"收到请求\");\r\n                    Log(body);\r\n                    bool isStream = body.Contains(\"\\\"stream\\\": true\") || body.Contains(\"\\\"stream\\\":true\");\r\n                    // 检查是否需要新建对话\r\n                    bool isNewConversation = body.Contains(\"\\\"new_conversation\\\": true\") || body.Contains(\"\\\"new_conversation\\\":true\");\r\n                    \r\n                    // 如果没有明确指定新对话，但消息历史只有一条系统消息和一条用户消息，也认为是新对话\r\n                    if (!isNewConversation) {\r\n                        try {\r\n                            // 简单检查消息数量，如果只有一条用户消息，则认为是新对话\r\n                            var userMessageMatches = Regex.Matches(body, \"\\\"role\\\"\\\\s*:\\\\s*\\\"user\\\"\");\r\n                            if (userMessageMatches.Count <= 1) {\r\n                                isNewConversation = true;\r\n                                Log(\"检测到单条用户消息，自动创建新对话\");\r\n                            }\r\n                        } catch { }\r\n                    }\r\n                    \r\n                    if (isNewConversation) {\r\n                        Log(\"检测到新对话请求\");\r\n                    }\r\n                    \r\n                    var (prompt, images) = ExtractPromptAndImages(body);\r\n                    if (string.IsNullOrWhiteSpace(prompt)) {\r\n                        if (!body.Trim().StartsWith(\"{\")) prompt = body;\r\n                        else { ResponseText(ctx, \"{\\\"error\\\": \\\"Parse Error\\\"}\", 400, \"application/json\"); return; }\r\n                    }\r\n                    _currentContext = ctx;\r\n                    _isCurrentRequestStreaming = isStream;\r\n                    _networkBuffer.Clear();\r\n                    _plainResponseBuffer.Clear();\r\n                    _lastEventType = \"\";\r\n                    _hasSeenUserMessage = false;  // 重置标记\r\n                    _sentImageUrls.Clear();  // 重置已处理图片集合\r\n\r\n                    if (isStream) {\r\n                        ctx.Response.ContentType = \"text/event-stream\";\r\n                        ctx.Response.AppendHeader(\"Cache-Control\", \"no-cache\");\r\n                        ctx.Response.AppendHeader(\"Connection\", \"keep-alive\");\r\n                    } else { ctx.Response.ContentType = \"application/json\"; }\r\n                    \r\n                    if (images.Count > 0) {\r\n                        this.Invoke(new Action(async () => {\r\n                            if (isNewConversation) {\r\n                                await EnsureNewConversationReady();\r\n                            }\r\n                            foreach (var img in images) {\r\n                                await InjectImageToWebView(img);\r\n                            }\r\n                            await Task.Delay(1000);\r\n                            await InjectPromptToWebView(prompt, false); // 新对话已创建，发送消息即可\r\n                        }));\r\n                    } else {\r\n                        this.Invoke(new Action(async () => {\r\n                            await InjectPromptToWebView(prompt, isNewConversation);\r\n                        }));\r\n                    }\r\n                }\r\n            } catch (Exception ex) { Log($\"Error: {ex.Message}\"); if (_currentContext == ctx) CleanupRequest(); }\r\n        } else { ResponseText(ctx, \"Not Found\", 404); }\r\n    }\r\n\r\n    private (string text, List<string> images) ExtractPromptAndImages(string json)\r\n    {\r\n        var images = new List<string>();\r\n        string textPrompt = \"\";\r\n\r\n        try {\r\n            var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);\r\n\r\n            // 尝试使用 Regex 解析 messages 数组\r\n            // 这对于 Roo-Code 非常重要，因为它需要保留 system 消息中的工具指令\r\n            var result = ExtractMessagesWithJson(json, seen, images);\r\n            if (result.HasValue)\r\n            {\r\n                return result.Value;\r\n            }\r\n\r\n            // 如果 JSON 解析失败，回退到原有的 regex 方式\r\n            Log(\"[DEBUG] JSON 解析失败，回退到 regex 方式\");\r\n\r\n            bool contentIsArray = false;\r\n            string contentScope = json;\r\n\r\n            // 优先抓取最后一条用户消息，兼容 content 为数组或纯字符串\r\n            var userMatches = Regex.Matches(\r\n                json,\r\n                \"\\\"role\\\"\\\\s*:\\\\s*\\\"user\\\".*?\\\"content\\\"\\\\s*:\\\\s*(\\\\[(.*?)\\\\]|\\\"((?:[^\\\"\\\\\\\\]|\\\\\\\\.)*)\\\")\",\r\n                RegexOptions.Singleline | RegexOptions.IgnoreCase\r\n            );\r\n            if (userMatches.Count > 0)\r\n            {\r\n                var lastUser = userMatches[userMatches.Count - 1];\r\n                if (lastUser.Groups[2].Success && !string.IsNullOrWhiteSpace(lastUser.Groups[2].Value))\r\n                {\r\n                    contentScope = lastUser.Groups[2].Value; // content 为数组\r\n                    contentIsArray = true;\r\n                }\r\n                else if (lastUser.Groups[3].Success)\r\n                {\r\n                    // content 为纯文本字符串\r\n                    textPrompt = UnescapeJson(lastUser.Groups[3].Value);\r\n                }\r\n            }\r\n\r\n            // 【重要修改】不再提前返回纯文本用户消息，而是继续提取 system 指令\r\n            // 这对于 Roo-Code 非常重要，因为 system 消息包含工具协议\r\n\r\n            // 只使用最后一个 content 数组，避免复用历史消息\r\n            Match lastContentMatch = null;\r\n            if (!contentIsArray)\r\n            {\r\n                var contentMatches = Regex.Matches(json, \"\\\"content\\\"\\\\s*:\\\\s*\\\\[(.*?)\\\\]\", RegexOptions.Singleline);\r\n                if (contentMatches.Count > 0) lastContentMatch = contentMatches[contentMatches.Count - 1];\r\n                contentScope = lastContentMatch != null ? lastContentMatch.Groups[1].Value : contentScope;\r\n            }\r\n\r\n            // 文本：抓取 content 列表中的 text，以及全局 text 字段作为兜底\r\n            var textMatches = Regex.Matches(contentScope, \"\\\"type\\\"\\\\s*:\\\\s*\\\"text\\\"[^}]*\\\"text\\\"\\\\s*:\\\\s*\\\"((?:[^\\\"\\\\\\\\]|\\\\\\\\.)*)\\\"\", RegexOptions.IgnoreCase);\r\n            bool multipleTexts = textMatches.Count > 1;\r\n            if (textMatches.Count > 0 && string.IsNullOrWhiteSpace(textPrompt))\r\n            {\r\n                // 只取最后一条文本，避免多轮历史堆叠\r\n                var last = textMatches[textMatches.Count - 1];\r\n                textPrompt = UnescapeJson(last.Groups[1].Value);\r\n            }\r\n            if (string.IsNullOrWhiteSpace(textPrompt))\r\n            {\r\n                var fallbackText = Regex.Matches(contentScope, \"\\\"text\\\"\\\\s*:\\\\s*\\\"((?:[^\\\"\\\\\\\\]|\\\\\\\\.)*)\\\"\");\r\n                if (fallbackText.Count > 0)\r\n                {\r\n                    var last = fallbackText[fallbackText.Count - 1];\r\n                    textPrompt = UnescapeJson(last.Groups[1].Value);\r\n                    multipleTexts = fallbackText.Count > 1;\r\n                }\r\n            }\r\n\r\n            // 如果检测到多条文本（可能是历史堆叠），不携带附件，防止重复发送旧文件\r\n            if (!multipleTexts)\r\n            {\r\n                // 附件/图片：尽可能多地抓取 url/file/data 三种形式\r\n                string[] patterns = new [] {\r\n                    \"\\\"image_url\\\"[^}]*\\\"url\\\"\\\\s*:\\\\s*\\\"((?:[^\\\"\\\\\\\\]|\\\\\\\\.)*)\\\"\",\r\n                    \"\\\"file_url\\\"[^}]*\\\"url\\\"\\\\s*:\\\\s*\\\"((?:[^\\\"\\\\\\\\]|\\\\\\\\.)*)\\\"\",\r\n                    \"\\\"type\\\"\\\\s*:\\\\s*\\\"file\\\"[^}]*\\\"(?:url|data|base64)\\\"\\\\s*:\\\\s*\\\"((?:[^\\\"\\\\\\\\]|\\\\\\\\.)*)\\\"\",\r\n                    \"\\\"url\\\"\\\\s*:\\\\s*\\\"((?:[^\\\"\\\\\\\\]|\\\\\\\\.)*(?:\\\\.pptx|\\\\.ppt|\\\\.pdf|\\\\.docx|\\\\.doc|\\\\.xls|\\\\.xlsx)(?:[^\\\"\\\\\\\\]*))\\\"\"\r\n                };\r\n                foreach (var pat in patterns)\r\n                {\r\n                    var ms = Regex.Matches(contentScope, pat, RegexOptions.IgnoreCase);\r\n                    foreach (Match m in ms)\r\n                    {\r\n                        string url = UnescapeJson(m.Groups[1].Value);\r\n                        if (seen.Add(url)) { images.Add(url); LogAttachment(url); }\r\n                    }\r\n                }\r\n\r\n                // data:...;base64,...\r\n                var dataAll = Regex.Matches(contentScope, \"data:[^\\\"\\\\\\\\\\\\s]+;base64,[^\\\"\\\\\\\\\\\\s]+\", RegexOptions.IgnoreCase);\r\n                foreach (Match m in dataAll)\r\n                {\r\n                    string url = UnescapeJson(m.Value);\r\n                    if (seen.Add(url)) { images.Add(url); LogAttachment(url); }\r\n                }\r\n\r\n                // 本地路径\r\n                var pathMatches = Regex.Matches(contentScope, \"([A-Za-z]:\\\\\\\\[^\\\"\\\\s]+\\\\.(?:pptx|ppt|pdf|docx|doc|xls|xlsx))\", RegexOptions.IgnoreCase);\r\n                foreach (Match m in pathMatches)\r\n                {\r\n                    string path = UnescapeJson(m.Groups[1].Value);\r\n                    if (seen.Add(path)) { images.Add(path); LogAttachment(path); }\r\n                }\r\n            }\r\n\r\n            Log($\"提取到 {images.Count} 个附件/图片\");\r\n\r\n            // 始终尝试提取 system 指令（对于 Roo-Code 非常重要）\r\n            string finalPrompt = ExtractPromptFromJsonWithSystem(json, textPrompt);\r\n            return (finalPrompt.Trim(), images);\r\n        } catch (Exception ex) {\r\n            Log($\"解析错误: {ex.Message}\");\r\n            return (ExtractPromptFromJson(json), images);\r\n        }\r\n    }\r\n\r\n    // 使用 Regex 解析 messages 数组（兼容 Quicker 环境，不依赖 System.Text.Json）\r\n    private (string text, List<string> images)? ExtractMessagesWithJson(string json, HashSet<string> seen, List<string> images)\r\n    {\r\n        try {\r\n            // 检查是否包含 messages 数组\r\n            if (!json.Contains(\"\\\"messages\\\"\"))\r\n            {\r\n                return null;\r\n            }\r\n\r\n            StringBuilder systemPrompt = new StringBuilder();\r\n            string lastUserContent = \"\";\r\n\r\n            // 兼容 {\"role\": \"...\", \"content\": ...} 以及 {\"content\": ..., \"role\": \"...\"} 顺序，使用 [\\s\\S]*? 允许字段间有换行/其它字段\r\n            var messagePattern = new Regex(\r\n                \"\\\"role\\\"\\\\s*:\\\\s*\\\"(system|user|assistant)\\\"[\\\\s\\\\S]*?\\\"content\\\"\\\\s*:\\\\s*(?:\\\"((?:[^\\\"\\\\\\\\]|\\\\\\\\.)*)\\\"|\\\\[(.*?)\\\\])|\\\"content\\\"\\\\s*:\\\\s*(?:\\\"((?:[^\\\"\\\\\\\\]|\\\\\\\\.)*)\\\"|\\\\[(.*?)\\\\])[\\\\s\\\\S]*?\\\"role\\\"\\\\s*:\\\\s*\\\"(system|user|assistant)\\\"\",\r\n                RegexOptions.IgnoreCase\r\n            );\r\n\r\n            var matches = messagePattern.Matches(json);\r\n            foreach (Match match in matches)\r\n            {\r\n                // role 可能在前（Group1）也可能在后（Group6）\r\n                string role = match.Groups[1].Success ? match.Groups[1].Value.ToLower() : match.Groups[6].Value.ToLower();\r\n                // content 也分字符串/数组两种，兼容前后顺序\r\n                string contentStr = match.Groups[2].Success ? match.Groups[2].Value : match.Groups[4].Value;\r\n                string contentArray = match.Groups[3].Success ? match.Groups[3].Value : match.Groups[5].Value;\r\n\r\n                string content = \"\";\r\n                if (!string.IsNullOrEmpty(contentStr))\r\n                {\r\n                    // content 是字符串\r\n                    content = UnescapeJson(contentStr);\r\n                }\r\n                else if (!string.IsNullOrEmpty(contentArray))\r\n                {\r\n                    // content 是数组，提取文本部分\r\n                    content = ExtractTextFromContentArray(contentArray, seen, images);\r\n                }\r\n\r\n                if (role == \"system\")\r\n                {\r\n                    // 始终保留 system 消息（对于 Roo-Code 的工具指令非常重要）\r\n                    if (!string.IsNullOrWhiteSpace(content))\r\n                    {\r\n                        if (systemPrompt.Length > 0) systemPrompt.Append(\"\\n\\n\");\r\n                        systemPrompt.Append(content);\r\n                    }\r\n                }\r\n                else if (role == \"user\")\r\n                {\r\n                    // 只保留最后一条 user 消息\r\n                    lastUserContent = content;\r\n                }\r\n                // assistant 消息通常不需要发送给豆包\r\n            }\r\n\r\n            // 构建最终提示词\r\n            StringBuilder finalPrompt = new StringBuilder();\r\n\r\n            // 始终添加 system 指令（这对 Roo-Code 非常关键）\r\n            if (systemPrompt.Length > 0)\r\n            {\r\n                finalPrompt.Append(\"[System Instructions]:\\n\");\r\n                finalPrompt.Append(systemPrompt.ToString());\r\n                finalPrompt.Append(\"\\n\\n[User Message]:\\n\");\r\n            }\r\n\r\n            finalPrompt.Append(lastUserContent);\r\n\r\n            Log($\"[Regex解析] system长度: {systemPrompt.Length}, user长度: {lastUserContent.Length}, 附件: {images.Count}\");\r\n\r\n            return (finalPrompt.ToString().Trim(), images);\r\n        }\r\n        catch (Exception ex)\r\n        {\r\n            Log($\"[Regex解析] 失败: {ex.Message}\");\r\n            return null;\r\n        }\r\n    }\r\n\r\n    // 从 content 数组中提取文本内容（使用 Regex）\r\n    private string ExtractTextFromContentArray(string contentArray, HashSet<string> seen, List<string> images)\r\n    {\r\n        StringBuilder textParts = new StringBuilder();\r\n\r\n        // 提取 type: \"text\" 的文本\r\n        var textPattern = new Regex(\r\n            @\"\"\"type\"\"\\s*:\\s*\"\"text\"\"[^}]*\"\"text\"\"\\s*:\\s*\"\"((?:[^\"\"\\\\]|\\\\.)*)\"\"\",\r\n            RegexOptions.Singleline | RegexOptions.IgnoreCase\r\n        );\r\n        var textMatches = textPattern.Matches(contentArray);\r\n        foreach (Match m in textMatches)\r\n        {\r\n            string text = UnescapeJson(m.Groups[1].Value);\r\n            if (!string.IsNullOrWhiteSpace(text))\r\n            {\r\n                if (textParts.Length > 0) textParts.Append(\"\\n\");\r\n                textParts.Append(text);\r\n            }\r\n        }\r\n\r\n        // 提取图片 URL\r\n        var imageUrlPattern = new Regex(\r\n            @\"\"\"type\"\"\\s*:\\s*\"\"image(?:_url)?\"\"\\s*[^}]*\"\"(?:image_)?url\"\"\\s*:\\s*(?:\\{[^}]*\"\"url\"\"\\s*:\\s*\"\"((?:[^\"\"\\\\]|\\\\.)*)\"\"|\"\"((?:[^\"\"\\\\]|\\\\.)*)\"\")\",\r\n            RegexOptions.Singleline | RegexOptions.IgnoreCase\r\n        );\r\n        var imageMatches = imageUrlPattern.Matches(contentArray);\r\n        foreach (Match m in imageMatches)\r\n        {\r\n            string url = m.Groups[1].Success ? m.Groups[1].Value : m.Groups[2].Value;\r\n            url = UnescapeJson(url);\r\n            if (!string.IsNullOrWhiteSpace(url) && seen.Add(url))\r\n            {\r\n                images.Add(url);\r\n                LogAttachment(url);\r\n            }\r\n        }\r\n\r\n        // 提取文件 URL\r\n        var fileUrlPattern = new Regex(\r\n            @\"\"\"type\"\"\\s*:\\s*\"\"file\"\"\\s*[^}]*\"\"(?:file_)?url\"\"\\s*:\\s*(?:\\{[^}]*\"\"url\"\"\\s*:\\s*\"\"((?:[^\"\"\\\\]|\\\\.)*)\"\"|\"\"((?:[^\"\"\\\\]|\\\\.)*)\"\")\",\r\n            RegexOptions.Singleline | RegexOptions.IgnoreCase\r\n        );\r\n        var fileMatches = fileUrlPattern.Matches(contentArray);\r\n        foreach (Match m in fileMatches)\r\n        {\r\n            string url = m.Groups[1].Success ? m.Groups[1].Value : m.Groups[2].Value;\r\n            url = UnescapeJson(url);\r\n            if (!string.IsNullOrWhiteSpace(url) && seen.Add(url))\r\n            {\r\n                images.Add(url);\r\n                LogAttachment(url);\r\n            }\r\n        }\r\n\r\n        return textParts.ToString();\r\n    }\r\n\r\n    // 提取包含 system 指令的完整提示词\r\n    private string ExtractPromptFromJsonWithSystem(string json, string userPrompt)\r\n    {\r\n        try {\r\n            string systemPrompt = \"\";\r\n\r\n            // 提取 system 消息\r\n            var systemMatches = Regex.Matches(\r\n                json,\r\n                \"\\\"role\\\"\\\\s*:\\\\s*\\\"system\\\".*?\\\"content\\\"\\\\s*:\\\\s*\\\"((?:[^\\\"\\\\\\\\]|\\\\\\\\.)*)\\\"\",\r\n                RegexOptions.Singleline | RegexOptions.IgnoreCase\r\n            );\r\n\r\n            if (systemMatches.Count > 0)\r\n            {\r\n                StringBuilder sb = new StringBuilder();\r\n                foreach (Match m in systemMatches)\r\n                {\r\n                    string content = UnescapeJson(m.Groups[1].Value);\r\n                    if (!string.IsNullOrWhiteSpace(content))\r\n                    {\r\n                        if (sb.Length > 0) sb.Append(\"\\n\\n\");\r\n                        sb.Append(content);\r\n                    }\r\n                }\r\n                systemPrompt = sb.ToString();\r\n            }\r\n\r\n            // 如果没有通过参数传入 userPrompt，尝试提取\r\n            if (string.IsNullOrWhiteSpace(userPrompt))\r\n            {\r\n                userPrompt = ExtractPromptFromJson(json);\r\n                // 如果 ExtractPromptFromJson 已经包含了 [System Instructions]，直接返回\r\n                if (userPrompt.Contains(\"[System Instructions]:\"))\r\n                {\r\n                    return userPrompt;\r\n                }\r\n            }\r\n\r\n            // 构建最终提示词\r\n            StringBuilder finalPrompt = new StringBuilder();\r\n            if (!string.IsNullOrWhiteSpace(systemPrompt))\r\n            {\r\n                finalPrompt.Append(\"[System Instructions]:\\n\");\r\n                finalPrompt.Append(systemPrompt);\r\n                finalPrompt.Append(\"\\n\\n[User Message]:\\n\");\r\n            }\r\n            finalPrompt.Append(userPrompt);\r\n\r\n            return finalPrompt.ToString().Trim();\r\n        }\r\n        catch (Exception ex)\r\n        {\r\n            Log($\"提取 system 指令失败: {ex.Message}\");\r\n            return userPrompt;\r\n        }\r\n    }\r\n\r\n    private async Task EnsureNewConversationReady()\r\n    {\r\n        try {\r\n            string newConvScript = \"window.DoubaoBridge.newConversation().then(() => { window.chrome.webview.postMessage('[LOG] 新建对话完成'); });\";\r\n            if (_coreWebView != null) await _coreWebView.ExecuteScriptAsync(newConvScript);\r\n            await Task.Delay(2000);\r\n        } catch (Exception ex) {\r\n            Log($\"新建对话失败: {ex.Message}\");\r\n        }\r\n    }\r\n\r\n    private string ExtractPromptFromJson(string json)\r\n    {\r\n        try {\r\n            string systemPrompt = \"\", userPrompt = \"\";\r\n            var roleRegex = new Regex(\"\\\"role\\\"\\\\s*:\\\\s*\\\"(system|user|assistant)\\\"\");\r\n            var contentRegex = new Regex(\"\\\"content\\\"\\\\s*:\\\\s*\\\"((?:[^\\\"\\\\\\\\]|\\\\\\\\.)*)\\\"\");\r\n            var roles = roleRegex.Matches(json).Cast<Match>().ToList();\r\n            var contents = contentRegex.Matches(json).Cast<Match>().ToList();\r\n\r\n            if (roles.Count > 0 && roles.Count == contents.Count) {\r\n                for (int i = 0; i < roles.Count; i++) {\r\n                    string r = roles[i].Groups[1].Value.ToLower();\r\n                    string c = UnescapeJson(contents[i].Groups[1].Value);\r\n                    if (r == \"system\") systemPrompt += c + \"\\n\\n\";\r\n                    else if (r == \"user\") userPrompt = c; \r\n                }\r\n            } else {\r\n                var lastMatch = contents.LastOrDefault();\r\n                if (lastMatch != null) userPrompt = UnescapeJson(lastMatch.Groups[1].Value);\r\n            }\r\n            string finalPrompt = \"\";\r\n            if (!string.IsNullOrWhiteSpace(systemPrompt)) finalPrompt += \"[System Instructions]:\\n\" + systemPrompt.Trim() + \"\\n\\n[User Message]:\\n\";\r\n            finalPrompt += userPrompt;\r\n            return finalPrompt.Trim();\r\n        } catch { return null; }\r\n    }\r\n\r\n    private async Task InjectPromptToWebView(string prompt, bool isNewConversation = false)\r\n    {\r\n        try {\r\n            if (isNewConversation) {\r\n                // 先执行新建对话的JavaScript\r\n                string newConvScript = \"window.DoubaoBridge.newConversation().then(() => { window.chrome.webview.postMessage('[LOG] 新建对话完成'); });\";\r\n                if (_coreWebView != null) await _coreWebView.ExecuteScriptAsync(newConvScript);\r\n                \r\n                // 等待一段时间确保新对话页面加载完成\r\n                await Task.Delay(2000);\r\n            }\r\n            \r\n            // 然后发送消息\r\n            string escapedPrompt = prompt.Replace(\"\\\\\", \"\\\\\\\\\").Replace(\"\\\"\", \"\\\\\\\"\").Replace(\"\\r\", \"\").Replace(\"\\n\", \"\\\\n\");\r\n            string script = $\"window.DoubaoBridge.sendPrompt(\\\"{escapedPrompt}\\\")\";\r\n            if (_coreWebView != null) await _coreWebView.ExecuteScriptAsync(script);\r\n        } catch (Exception ex) {\r\n            Log($\"注入提示失败: {ex.Message}\");\r\n        }\r\n    }\r\n\r\n    private async Task InjectImageToWebView(string imageData)\r\n    {\r\n        try {\r\n            string dataUrl = imageData;\r\n            string fileName = \"uploaded_file\";\r\n\r\n            if (imageData.StartsWith(\"data:\", StringComparison.OrdinalIgnoreCase))\r\n            {\r\n                // base64 data, keep as-is\r\n                try {\r\n                    string mime = imageData.Substring(5, imageData.IndexOf(';') - 5);\r\n                    string ext = GetExtensionFromContentType(mime);\r\n                    if (!string.IsNullOrEmpty(ext)) fileName = \"uploaded_file\" + ext;\r\n                } catch { }\r\n            }\r\n            else if (imageData.StartsWith(\"http://\", StringComparison.OrdinalIgnoreCase) || imageData.StartsWith(\"https://\", StringComparison.OrdinalIgnoreCase))\r\n            {\r\n                // 下载远程文件并转为 data URL\r\n                using (var client = new WebClient())\r\n                {\r\n                    byte[] bytes = await client.DownloadDataTaskAsync(imageData);\r\n                    string contentType = client.ResponseHeaders?[\"Content-Type\"];\r\n                    if (string.IsNullOrWhiteSpace(contentType)) contentType = \"application/octet-stream\";\r\n                    fileName = Path.GetFileName(new Uri(imageData).AbsolutePath);\r\n                    if (string.IsNullOrWhiteSpace(fileName)) fileName = \"uploaded_file\" + GetExtensionFromContentType(contentType);\r\n                    else if (Path.GetExtension(fileName) == string.Empty) fileName = fileName + GetExtensionFromContentType(contentType);\r\n                    dataUrl = BuildDataUrl(bytes, contentType);\r\n                }\r\n            }\r\n            else if (imageData.StartsWith(\"file://\", StringComparison.OrdinalIgnoreCase))\r\n            {\r\n                string localPath = new Uri(imageData).LocalPath;\r\n                if (File.Exists(localPath))\r\n                {\r\n                    byte[] bytes = File.ReadAllBytes(localPath);\r\n                    string contentType = GetContentTypeFromExtension(localPath);\r\n                    fileName = Path.GetFileName(localPath);\r\n                    dataUrl = BuildDataUrl(bytes, contentType);\r\n                }\r\n                else\r\n                {\r\n                    Log($\"本地文件不存在: {localPath}\");\r\n                    return;\r\n                }\r\n            }\r\n            else if (File.Exists(imageData))\r\n            {\r\n                // 本地文件路径\r\n                byte[] bytes = File.ReadAllBytes(imageData);\r\n                string contentType = GetContentTypeFromExtension(imageData);\r\n                fileName = Path.GetFileName(imageData);\r\n                if (Path.GetExtension(fileName) == string.Empty) fileName = fileName + GetExtensionFromContentType(contentType);\r\n                dataUrl = BuildDataUrl(bytes, contentType);\r\n            }\r\n            else\r\n            {\r\n                Log($\"不支持的图片/文件格式: {imageData.Substring(0, Math.Min(80, imageData.Length))}\");\r\n                return;\r\n            }\r\n\r\n            string escapedData = dataUrl.Replace(\"\\\\\", \"\\\\\\\\\").Replace(\"\\\"\", \"\\\\\\\"\").Replace(\"\\n\", \"\").Replace(\"\\r\", \"\");\r\n            string escapedFile = fileName.Replace(\"\\\\\", \"\").Replace(\"\\\"\", \"\");\r\n            string script = $\"window.DoubaoBridge.uploadImage(\\\"{escapedData}\\\", \\\"{escapedFile}\\\")\";\r\n            Log(\"正在上传图片/文件...\");\r\n            if (_coreWebView != null) await _coreWebView.ExecuteScriptAsync(script);\r\n        } catch (Exception ex) {\r\n            Log($\"图片上传失败: {ex.Message}\");\r\n        }\r\n    }\r\n\r\n    private string BuildDataUrl(byte[] bytes, string contentType)\r\n    {\r\n        string base64 = Convert.ToBase64String(bytes);\r\n        return $\"data:{contentType};base64,{base64}\";\r\n    }\r\n\r\n    private string GetExtensionFromContentType(string contentType)\r\n    {\r\n        if (string.IsNullOrWhiteSpace(contentType)) return \"\";\r\n        switch (contentType.ToLowerInvariant())\r\n        {\r\n            case \"image/png\": return \".png\";\r\n            case \"image/jpeg\": return \".jpg\";\r\n            case \"image/jpg\": return \".jpg\";\r\n            case \"image/gif\": return \".gif\";\r\n            case \"image/bmp\": return \".bmp\";\r\n            case \"image/webp\": return \".webp\";\r\n            case \"image/heic\": return \".heic\";\r\n            case \"image/svg+xml\": return \".svg\";\r\n            case \"application/pdf\": return \".pdf\";\r\n            case \"application/vnd.ms-powerpoint\": return \".ppt\";\r\n            case \"application/vnd.openxmlformats-officedocument.presentationml.presentation\": return \".pptx\";\r\n            case \"application/msword\": return \".doc\";\r\n            case \"application/vnd.openxmlformats-officedocument.wordprocessingml.document\": return \".docx\";\r\n            case \"application/vnd.ms-excel\": return \".xls\";\r\n            case \"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet\": return \".xlsx\";\r\n            default: return \"\";\r\n        }\r\n    }\r\n\r\n    private string GetContentTypeFromExtension(string path)\r\n    {\r\n        string ext = Path.GetExtension(path)?.ToLowerInvariant() ?? \"\";\r\n        switch (ext)\r\n        {\r\n            case \".png\": return \"image/png\";\r\n            case \".jpg\":\r\n            case \".jpeg\": return \"image/jpeg\";\r\n            case \".gif\": return \"image/gif\";\r\n            case \".bmp\": return \"image/bmp\";\r\n            case \".webp\": return \"image/webp\";\r\n            case \".heic\": return \"image/heic\";\r\n            case \".svg\": return \"image/svg+xml\";\r\n            case \".pdf\": return \"application/pdf\";\r\n            case \".ppt\":\r\n            case \".pptx\": return \"application/vnd.openxmlformats-officedocument.presentationml.presentation\";\r\n            case \".doc\":\r\n            case \".docx\": return \"application/vnd.openxmlformats-officedocument.wordprocessingml.document\";\r\n            case \".xls\":\r\n            case \".xlsx\": return \"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet\";\r\n            case \".txt\": return \"text/plain\";\r\n            default: return \"application/octet-stream\";\r\n        }\r\n    }\r\n\r\n    private void OnWebMessageReceived(object sender, CoreWebView2WebMessageReceivedEventArgs e)\r\n    {\r\n        try {\r\n            string msg = e.TryGetWebMessageAsString();\r\n            Log($\"[DEBUG] 收到消息: {msg.Substring(0, Math.Min(50, msg.Length))}...\");\r\n            \r\n            if (msg.StartsWith(\"[LOG]\")) { Log(msg); return; }\r\n            \r\n            if (msg.StartsWith(\"[GENERATED_IMAGE]\")) {\r\n                string imageUrl = msg.Substring(17);\r\n                HandleGeneratedImageUrl(imageUrl);\r\n                return;\r\n            }\r\n            \r\n            if (_currentContext == null) {\r\n                Log($\"[DEBUG] 当前无活动请求，忽略消息: {msg.Substring(0, Math.Min(50, msg.Length))}...\");\r\n                return;\r\n            }\r\n            \r\n            if (msg.StartsWith(\"[NETWORK_DONE]\")) {\r\n                Log(\"[DEBUG] 处理NETWORK_DONE消息\");\r\n                FinishRequest();\r\n                return;\r\n            }\r\n            \r\n            if (msg.StartsWith(\"[NETWORK_DATA]\")) {\r\n                string rawData = msg.Substring(14);\r\n                Log($\"[DEBUG] 处理NETWORK_DATA消息，长度: {rawData.Length}\");\r\n                ProcessNetworkData(rawData);\r\n            }\r\n        } catch (Exception ex) { Log($\"消息处理错误: {ex.Message}\"); }\r\n    }\r\n\r\n    private void HandleGeneratedImageUrl(string imageUrl)\r\n    {\r\n        imageUrl = NormalizeImageUrl(imageUrl);\r\n        if (string.IsNullOrWhiteSpace(imageUrl)) return;\r\n        \r\n        if (!IsAllowedImageUrl(imageUrl)) {\r\n            Log($\"[IMAGE_DEBUG] 跳过不需要的图片URL: {imageUrl.Substring(0, Math.Min(80, imageUrl.Length))}\");\r\n            return;\r\n        }\r\n\r\n        if (_sentImageUrls.Contains(imageUrl)) {\r\n            Log($\"[IMAGE_DEBUG] 图片URL已处理，跳过: {imageUrl.Substring(0, Math.Min(80, imageUrl.Length))}\");\r\n            return;\r\n        }\r\n        _sentImageUrls.Add(imageUrl);\r\n        _isImageGenerationPending = false;  // 已经拿到图片URL，不再等待提示\r\n        Log($\"[IMAGE] ✅ 拦截到图片URL: {imageUrl}\");\r\n\r\n        if (_currentContext != null && !_hasProcessedImage) {\r\n            _hasProcessedImage = true;\r\n            SendDelta($\"\\n\\n![generated_image]({imageUrl})\\n\\n\");\r\n            Log($\"[NET] \\\\n\\\\n![generated_image]({imageUrl})\\\\n\\\\n\");\r\n        }\r\n        else if (_currentContext != null) {\r\n            _pendingImageUrls.Add(imageUrl);\r\n            Log($\"[IMAGE] 图片已处理，添加到待处理列表: {imageUrl.Substring(0, Math.Min(50, imageUrl.Length))}...\");\r\n        }\r\n        else {\r\n            _pendingImageUrls.Add(imageUrl);\r\n            Log($\"[IMAGE] 请求已结束，存储图片URL待处理: {imageUrl.Substring(0, Math.Min(50, imageUrl.Length))}...\");\r\n        }\r\n    }\r\n\r\n    private IEnumerable<string> ExtractImageUrlsFromJson(string json)\r\n    {\r\n        if (string.IsNullOrWhiteSpace(json)) yield break;\r\n        // 同时匹配带转义斜杠和普通URL\r\n        var matches = Regex.Matches(json, @\"https?:\\\\/\\\\/[^\"\"]*rc_gen_image[^\"\"]*|https?://[^\"\"\\s]*rc_gen_image[^\"\"\\s]*\", RegexOptions.IgnoreCase);\r\n        foreach (Match m in matches) {\r\n            string url = NormalizeImageUrl(m.Value);\r\n            if (string.IsNullOrWhiteSpace(url)) continue;\r\n            if (!IsAllowedImageUrl(url)) continue;\r\n            yield return url;\r\n        }\r\n    }\r\n    private void ProcessNetworkData(string rawChunk)\r\n    {\r\n        _networkBuffer.Append(rawChunk);\r\n        string bufferStr = _networkBuffer.ToString();\r\n        \r\n        if (_isDebugMode && rawChunk.Length > 0) { \r\n             string debugSnippet = rawChunk.Length > 100 ? rawChunk.Substring(0, 100) + \"...\" : rawChunk;\r\n             Log($\"[RAW] {debugSnippet.Replace(\"\\n\", \"\\\\n\")}\");\r\n        }\r\n        \r\n        int lastNewLine = bufferStr.LastIndexOf('\\n');\r\n        if (lastNewLine == -1) return; \r\n        \r\n        string processablePart = bufferStr.Substring(0, lastNewLine + 1);\r\n        _networkBuffer.Remove(0, lastNewLine + 1);\r\n\r\n        using (StringReader reader = new StringReader(processablePart))\r\n        {\r\n            string line;\r\n            while ((line = reader.ReadLine()) != null) {\r\n                if (string.IsNullOrWhiteSpace(line)) { _lastEventType = \"\"; continue; }\r\n                line = line.Trim();\r\n                \r\n                if (line.StartsWith(\"event:\")) { \r\n                    _lastEventType = line.Substring(6).Trim(); \r\n                }\r\n                else if (line.StartsWith(\"data:\")) {\r\n                    string json = line.Substring(5).Trim();\r\n                    \r\n                    // 从豆包的SSE data中提取文本内容\r\n                    string content = ExtractTextFromDoubaoData(json);\r\n                    \r\n                    if (!string.IsNullOrEmpty(content) && content != \"[DONE]\") {\r\n                        SendDelta(content);\r\n                    }\r\n                }\r\n            }\r\n        }\r\n    }\r\n\r\n    private string ExtractTextFromDoubaoData(string json)\r\n    {\r\n        // 先尝试从JSON中提取图片URL\r\n        foreach (var imgUrl in ExtractImageUrlsFromJson(json)) {\r\n            HandleGeneratedImageUrl(imgUrl);\r\n        }\r\n        \r\n        // 调试日志\r\n        if (_isDebugMode && json.Length < 500) {\r\n            Log($\"[DEBUG_JSON] {json}\");\r\n        } else if (_isDebugMode && json.Length >= 500) {\r\n            Log($\"[DEBUG_JSON] {json.Substring(0, 500)}...\");\r\n        }\r\n\r\n        // 1. 处理总结信息\r\n        if (json.Contains(\"\\\"brief\\\":\"))\r\n        {\r\n            var briefMatch = Regex.Match(json, \"\\\"brief\\\"\\\\s*:\\\\s*\\\"((?:[^\\\"\\\\\\\\]|\\\\\\\\.)*)\\\"\");\r\n            if (briefMatch.Success)\r\n            {\r\n                string brief = UnescapeJson(briefMatch.Groups[1].Value);\r\n                Log($\"[INFO] 最终摘要: {brief}\");\r\n            }\r\n        }\r\n        \r\n        // 2. 更新块 ID 和 状态切换逻辑\r\n        // 检测思考父块 (block_type: 10040)\r\n        if (json.Contains(\"\\\"block_type\\\":10040\") || json.Contains(\"\\\"block_type\\\": 10040\"))\r\n        {\r\n            var idMatch = Regex.Match(json, \"\\\"block_id\\\"\\\\s*:\\\\s*\\\"([^\\\"]*)\\\"\");\r\n            if (idMatch.Success)\r\n            {\r\n                _thinkingBlockId = idMatch.Groups[1].Value;\r\n                Log($\"[THINK] 更新思考父块 ID: {_thinkingBlockId}\");\r\n            }\r\n        }\r\n\r\n        // 仅在检测到显式的新块定义 (block_type: 10000) 时更新持久化的思考状态\r\n        // 这样可以确保中间的 CHUNK_DELTA (通常不带块信息) 能够继承正确的状态\r\n        if (json.Contains(\"\\\"block_type\\\":10000\") || json.Contains(\"\\\"block_type\\\": 10000\"))\r\n        {\r\n            // 跳过用户问题块\r\n            if (!_hasSeenUserMessage)\r\n            {\r\n                _hasSeenUserMessage = true;\r\n                Log(\"[SKIP] 跳过用户问题块\");\r\n                return null;\r\n            }\r\n\r\n            // 检查这个新块是否为思考块的子块\r\n            if (!string.IsNullOrEmpty(_thinkingBlockId) && json.Contains($\"\\\"parent_id\\\":\\\"{_thinkingBlockId}\\\"\"))\r\n            {\r\n                if (!_isCurrentBlockThinking) {\r\n                    _isCurrentBlockThinking = true;\r\n                    Log(\"[THINK] 进入思考模式\");\r\n                }\r\n            }\r\n            else\r\n            {\r\n                // 如果是 10000 块但没有 parent_id，或者是其他 parent，则视为正式回答的文字\r\n                if (_isCurrentBlockThinking) {\r\n                    _isCurrentBlockThinking = false;\r\n                    Log(\"[THINK] 退出思考模式 (检测到新的独立块或非思考 Parent)\");\r\n                }\r\n            }\r\n        }\r\n        \r\n        // 处理图片提示过滤\r\n        if (_hasProcessedImage && (json.Contains(\"以下是为你生成的图片\") || json.Contains(\"为您生成图片\") || json.Contains(\"生成的图片\")))\r\n        {\r\n            return null;\r\n        }\r\n        if (!_hasProcessedImage && (json.Contains(\"以下是为你生成的图片\") || json.Contains(\"为您生成图片\") || json.Contains(\"生成的图片\")))\r\n        {\r\n            _isImageGenerationPending = true;\r\n            return \"正在生成图片，请稍候...\\n\\n\";\r\n        }\r\n\r\n        // 3. 提取文字内容\r\n        string content = null;\r\n\r\n        // 优先提取 text_block (STREAM_MSG_NOTIFY/PATCH)\r\n        var textMatch = Regex.Match(json, \"\\\"text_block\\\"\\\\s*:\\\\s*\\\\{\\\\s*\\\"text\\\"\\\\s*:\\\\s*\\\"((?:[^\\\"\\\\\\\\]|\\\\\\\\.)*)\\\"\");\r\n        if (textMatch.Success)\r\n        {\r\n            content = UnescapeJson(textMatch.Groups[1].Value);\r\n        }\r\n        // 兜底提取 text 字段 (CHUNK_DELTA/CHUNK_DELTA)\r\n        else\r\n        {\r\n            var deltaMatch = Regex.Match(json, \"\\\"text\\\"\\\\s*:\\\\s*\\\"((?:[^\\\"\\\\\\\\]|\\\\\\\\.)*)\\\"\");\r\n            if (deltaMatch.Success)\r\n            {\r\n                content = UnescapeJson(deltaMatch.Groups[1].Value);\r\n            }\r\n        }\r\n\r\n        // 4. 根据当前持久化的模式组装返回内容\r\n        if (!string.IsNullOrEmpty(content))\r\n        {\r\n            if (_isCurrentBlockThinking)\r\n            {\r\n                if (!_isThinkingActive)\r\n                {\r\n                    _isThinkingActive = true;\r\n                    return \"<think>\\n\" + content;\r\n                }\r\n                return content;\r\n            }\r\n            else\r\n            {\r\n                if (_isThinkingActive)\r\n                {\r\n                    _isThinkingActive = false;\r\n                    return \"\\n</think>\\n\\n\" + content;\r\n                }\r\n                return content;\r\n            }\r\n        }\r\n\r\n        return null;\r\n    }\r\n\r\n    private string UnescapeJson(string str) {\r\n        if (string.IsNullOrEmpty(str)) return str;\r\n\r\n        // 先处理 Unicode 转义序列 \\uXXXX（这对于 Roo-Code 的 XML 标签非常重要）\r\n        // 例如 \\u003c 需要转换为 < ，\\u003e 需要转换为 >\r\n        str = Regex.Replace(str, @\"\\\\u([0-9A-Fa-f]{4})\", match => {\r\n            int code = int.Parse(match.Groups[1].Value, System.Globalization.NumberStyles.HexNumber);\r\n            return ((char)code).ToString();\r\n        });\r\n\r\n        // 然后处理标准 JSON 转义\r\n        return str.Replace(\"\\\\\\\"\", \"\\\"\").Replace(\"\\\\\\\\\", \"\\\\\").Replace(\"\\\\n\", \"\\n\").Replace(\"\\\\r\", \"\\r\").Replace(\"\\\\t\", \"\\t\");\r\n    }\r\n\r\n    private void SendDelta(string text) {\r\n        if (_isCurrentRequestStreaming) {\r\n            string jsonChunk = $\"{{\\\"id\\\":\\\"chatcmpl-doubao\\\",\\\"object\\\":\\\"chat.completion.chunk\\\",\\\"created\\\":{DateTimeOffset.Now.ToUnixTimeSeconds()},\\\"model\\\":\\\"doubao-chat\\\",\\\"choices\\\":[{{\\\"index\\\":0,\\\"delta\\\":{{\\\"content\\\":\\\"{EscapeJson(text)}\\\"}},\\\"finish_reason\\\":null}}]}}\";\r\n            WriteSseData($\"data: {jsonChunk}\\n\\n\");\r\n        } else {\r\n            _plainResponseBuffer.Append(text);\r\n        }\r\n        string logText = text.Replace(\"\\n\", \"\\\\n\");\r\n        Log($\"[NET] {logText}\");\r\n    }\r\n\r\n    private async void FinishRequest() {\r\n        Log(\"Stream Finished\");\r\n        \r\n        // 如果结束时还在思考，补全标签\r\n        if (_isThinkingActive)\r\n        {\r\n            SendDelta(\"\\n</think>\\n\\n\");\r\n            _isThinkingActive = false;\r\n        }\r\n\r\n        if (_networkBuffer.Length > 0) { ProcessNetworkData(\"\\n\"); _networkBuffer.Clear(); }\r\n        \r\n        // 如果检测到图片生成，等待一段时间以便接收图片URL\r\n        if (_hasProcessedImage || _pendingImageUrls.Count > 0 || _isImageGenerationPending) {\r\n            Log(\"[IMAGE] 检测到图片生成，等待图片URL...\");\r\n            \r\n            // 保存当前上下文引用，防止在等待期间被清理\r\n            var currentContext = _currentContext;\r\n            \r\n            // 等待更长时间，确保图片URL能够被接收\r\n            for (int i = 0; i < 10; i++) { // 最多等待10秒，每秒检查一次\r\n                await Task.Delay(1000);\r\n                \r\n                if (_pendingImageUrls.Count > 0 && currentContext != null) {\r\n                    Log($\"[IMAGE] 发送 {_pendingImageUrls.Count} 个待处理的图片URL\");\r\n                    foreach (var imageUrl in _pendingImageUrls) {\r\n                        try {\r\n                            if (_isCurrentRequestStreaming) {\r\n                                string jsonChunk = $\"{{\\\"id\\\":\\\"chatcmpl-doubao\\\",\\\"object\\\":\\\"chat.completion.chunk\\\",\\\"created\\\":{DateTimeOffset.Now.ToUnixTimeSeconds()},\\\"model\\\":\\\"doubao-chat\\\",\\\"choices\\\":[{{\\\"index\\\":0,\\\"delta\\\":{{\\\"content\\\":\\\"\\\\n\\\\n![generated_image]({EscapeJson(imageUrl)})\\\\n\\\\n\\\"}},\\\"finish_reason\\\":null}}]}}\";\r\n                                string sseData = $\"data: {jsonChunk}\\n\\n\";\r\n                                byte[] buffer = Encoding.UTF8.GetBytes(sseData);\r\n                                currentContext.Response.OutputStream.Write(buffer, 0, buffer.Length);\r\n                                currentContext.Response.OutputStream.Flush();\r\n                            } else {\r\n                                _plainResponseBuffer.Append($\"\\n\\n![generated_image]({imageUrl})\\n\\n\");\r\n                            }\r\n                            Log($\"[NET] \\\\n\\\\n![generated_image]({imageUrl})\\\\n\\\\n\");\r\n                        } catch (Exception ex) {\r\n                            Log($\"[IMAGE] 发送图片URL失败: {ex.Message}\");\r\n                        }\r\n                    }\r\n                    _pendingImageUrls.Clear();\r\n                }\r\n                \r\n                // 如果已经等待了5秒还没有新的图片URL，提前退出\r\n                if (i >= 5 && _pendingImageUrls.Count == 0 && !_isImageGenerationPending) {\r\n                    Log(\"[IMAGE] 5秒内没有新的图片URL，提前退出等待\");\r\n                    break;\r\n                }\r\n            }\r\n            _isImageGenerationPending = false;\r\n        }\r\n        \r\n        if (_isCurrentRequestStreaming) {\r\n            string stopChunk = $\"{{\\\"id\\\":\\\"chatcmpl-doubao\\\",\\\"object\\\":\\\"chat.completion.chunk\\\",\\\"created\\\":{DateTimeOffset.Now.ToUnixTimeSeconds()},\\\"model\\\":\\\"doubao-chat\\\",\\\"choices\\\":[{{\\\"index\\\":0,\\\"delta\\\":{{}},\\\"finish_reason\\\":\\\"stop\\\"}}]}}\";\r\n            WriteSseData($\"data: {stopChunk}\\n\\n\");\r\n            WriteSseData(\"data: [DONE]\\n\\n\");\r\n        } else {\r\n            string content = EscapeJson(_plainResponseBuffer.ToString());\r\n            string finalJson = $\"{{\\\"id\\\":\\\"chatcmpl-doubao\\\",\\\"object\\\":\\\"chat.completion\\\",\\\"created\\\":{DateTimeOffset.Now.ToUnixTimeSeconds()},\\\"model\\\":\\\"doubao-chat\\\",\\\"choices\\\":[{{\\\"index\\\":0,\\\"finish_reason\\\":\\\"stop\\\",\\\"message\\\":{{\\\"role\\\":\\\"assistant\\\",\\\"content\\\":\\\"{content}\\\"}}}}]}}\";\r\n            ResponseText(_currentContext, finalJson, 200, \"application/json\");\r\n        }\r\n        CleanupRequest();\r\n    }\r\n\r\n    private void WriteSseData(string data) {\r\n        try {\r\n            byte[] buffer = Encoding.UTF8.GetBytes(data);\r\n            _currentContext.Response.OutputStream.Write(buffer, 0, buffer.Length);\r\n            _currentContext.Response.OutputStream.Flush();\r\n        } catch { CleanupRequest(); }\r\n    }\r\n\r\n    private void CleanupRequest() {\r\n        try {\r\n            _currentContext?.Response.Close();\r\n        } catch { }\r\n        _currentContext = null;\r\n        _networkBuffer.Clear();\r\n        _plainResponseBuffer.Clear();\r\n        _thinkingBlockId = \"\"; // 重置思考块ID\r\n        _isThinkingActive = false; // 重置思考激活状态\r\n        _isCurrentBlockThinking = false; // 重置当前块思考状态\r\n        _hasSeenUserMessage = false;  // 重置标记\r\n        _hasProcessedImage = false;  // 重置图片处理标记\r\n        _isImageGenerationPending = false;  // 重置等待图片标记\r\n        _pendingImageUrls.Clear();  // 清空待处理的图片URL\r\n        _sentImageUrls.Clear();  // 清空已发送图片URL记录\r\n    }\r\n\r\n    private void ResponseText(HttpListenerContext ctx, string text, int code = 200, string contentType = \"text/plain\") {\r\n        try {\r\n            ctx.Response.StatusCode = code; ctx.Response.ContentType = contentType;\r\n            byte[] buffer = Encoding.UTF8.GetBytes(text);\r\n            ctx.Response.ContentLength64 = buffer.Length;\r\n            ctx.Response.OutputStream.Write(buffer, 0, buffer.Length);\r\n            ctx.Response.Close();\r\n        } catch { }\r\n    }\r\n\r\n    private string EscapeJson(string s) {\r\n        if (s == null) return \"\";\r\n        return s.Replace(\"\\\\\", \"\\\\\\\\\").Replace(\"\\\"\", \"\\\\\\\"\").Replace(\"\\n\", \"\\\\n\").Replace(\"\\r\", \"\\\\r\").Replace(\"\\t\", \"\\\\t\");\r\n    }\r\n\r\n    private string NormalizeImageUrl(string url)\r\n    {\r\n        if (string.IsNullOrWhiteSpace(url)) return null;\r\n        string normalized = UnescapeJson(url).Replace(\"\\\\/\", \"/\");\r\n        normalized = normalized.Replace(\"\\\\u0026\", \"&\").Replace(\"\\u0026\", \"&\");\r\n        normalized = normalized.Trim().Trim('\\\\');\r\n        return normalized;\r\n    }\r\n\r\n    private void LogAttachment(string url)\r\n    {\r\n        try {\r\n            string brief = url.Length > 120 ? url.Substring(0, 120) + \"...\" : url;\r\n            Log($\"[ATTACH] 捕获附件: {brief}\");\r\n        } catch { }\r\n    }\r\n\r\n    private bool IsAllowedImageUrl(string url)\r\n    {\r\n        if (string.IsNullOrWhiteSpace(url)) return false;\r\n        if (!Uri.TryCreate(url, UriKind.Absolute, out var uri)) return false;\r\n        // 屏蔽需要鉴权的 review 域名，只保留公开可访问的 byteimg 域\r\n        if (uri.Host.IndexOf(\"byteimg.com\", StringComparison.OrdinalIgnoreCase) < 0) return false;\r\n        if (uri.Host.IndexOf(\"review\", StringComparison.OrdinalIgnoreCase) >= 0) return false;\r\n        // 只保留包含 rc_gen_image 的路径\r\n        if (uri.AbsolutePath.IndexOf(\"rc_gen_image\", StringComparison.OrdinalIgnoreCase) < 0) return false;\r\n        return true;\r\n    }\r\n\r\n    private void Log(string msg) {\r\n        if (!_isDebugMode) return;\r\n        if (_txtLog != null && !_txtLog.IsDisposed) {\r\n            if (_txtLog.InvokeRequired) _txtLog.Invoke(new Action(() => Log(msg)));\r\n            else { _txtLog.AppendText($\"[{DateTime.Now:HH:mm:ss}] {msg}\\r\\n\"); }\r\n        }\r\n    }\r\n\r\n    private void ShowToast() {\r\n        if (_notifyIcon != null) {\r\n            _notifyIcon.ShowBalloonTip(3000, \"Doubao Relay\", $\"服务已启动 (端口: {ServerPort})\", ToolTipIcon.Info);\r\n        }\r\n    }\r\n\r\n    private string GetNetworkInterceptorScript() {\r\n        return @\"\r\n        window.chrome.webview.postMessage('[LOG] 网络拦截器加载中...');\r\n        \r\n        // 拦截 Fetch API\r\n        const originalFetch = window.fetch;\r\n        window.fetch = async (...args) => {\r\n            let url = '';\r\n            try { \r\n                if (args[0] instanceof Request) url = args[0].url; \r\n                else url = args[0].toString(); \r\n            } catch(e) { url = 'unknown'; }\r\n            \r\n            // 拦截图片生成的请求（包含 rc_gen_image 的图片URL）\r\n            if (url.indexOf('rc_gen_image') !== -1 && (url.indexOf('byteimg.com') !== -1 || url.indexOf('doubao.com') !== -1)) {\r\n                window.chrome.webview.postMessage('[LOG] [IMAGE_FETCH] 拦截到图片: ' + url);\r\n                // 直接发送图片URL，不进行编码\r\n                window.chrome.webview.postMessage('[GENERATED_IMAGE]' + url);\r\n                return; // 确保这个请求不会继续执行\r\n            }\r\n            \r\n            // 豆包的API端点通常包含 'stream' 或 'chat'\r\n            if ((url.indexOf('stream') !== -1 || url.indexOf('chat') !== -1) && url.indexOf('doubao.com') !== -1) {\r\n                window.chrome.webview.postMessage('[LOG] [Fetch] 拦截: ' + url);\r\n                try {\r\n                    const response = await originalFetch(...args);\r\n                    const clone = response.clone();\r\n                    const reader = clone.body.getReader();\r\n                    const decoder = new TextDecoder();\r\n                    \r\n                    (async () => {\r\n                        try {\r\n                            while (true) {\r\n                                const { done, value } = await reader.read();\r\n                                if (done) { \r\n                                    window.chrome.webview.postMessage('[NETWORK_DONE]'); \r\n                                    break; \r\n                                }\r\n                                const text = decoder.decode(value, {stream: true});\r\n                                window.chrome.webview.postMessage('[NETWORK_DATA]' + text);\r\n                            }\r\n                        } catch (e) { \r\n                            window.chrome.webview.postMessage('[LOG] Fetch Stream 错误: ' + e); \r\n                        }\r\n                    })();\r\n                    \r\n                    return response;\r\n                } catch (e) { \r\n                    window.chrome.webview.postMessage('[LOG] Fetch 执行错误: ' + e); \r\n                    return originalFetch(...args); \r\n                }\r\n            }\r\n            return originalFetch(...args);\r\n        };\r\n        \r\n        // 拦截 XMLHttpRequest\r\n        const OriginalXHR = window.XMLHttpRequest;\r\n        window.XMLHttpRequest = function() {\r\n            const xhr = new OriginalXHR();\r\n            let url = '';\r\n            const originalOpen = xhr.open;\r\n            \r\n            xhr.open = function(method, requestUrl) {\r\n                url = requestUrl || '';\r\n                if ((url.indexOf('stream') !== -1 || url.indexOf('chat') !== -1) && url.indexOf('doubao.com') !== -1) { \r\n                    window.chrome.webview.postMessage('[LOG] [XHR] 拦截: ' + url); \r\n                }\r\n                return originalOpen.apply(this, arguments);\r\n            };\r\n            \r\n            xhr.addEventListener('progress', function() {\r\n                if ((url.indexOf('stream') !== -1 || url.indexOf('chat') !== -1) && url.indexOf('doubao.com') !== -1) {\r\n                    try {\r\n                        let fullText = '';\r\n                        try { fullText = xhr.responseText; } catch(e) { return; }\r\n                        if (!fullText) return;\r\n                        \r\n                        const lastLen = xhr._lastLength || 0;\r\n                        const newChunk = fullText.substring(lastLen);\r\n                        if (newChunk.length > 0) {\r\n                            window.chrome.webview.postMessage('[NETWORK_DATA]' + newChunk);\r\n                            xhr._lastLength = fullText.length;\r\n                        }\r\n                    } catch(e) { \r\n                        window.chrome.webview.postMessage('[LOG] XHR Progress 错误: ' + e); \r\n                    }\r\n                }\r\n            });\r\n            \r\n            xhr.addEventListener('load', function() { \r\n                if ((url.indexOf('stream') !== -1 || url.indexOf('chat') !== -1) && url.indexOf('doubao.com') !== -1) { \r\n                    window.chrome.webview.postMessage('[NETWORK_DONE]'); \r\n                } \r\n            });\r\n            \r\n            return xhr;\r\n        };\r\n        \r\n        window.chrome.webview.postMessage('[LOG] 拦截器就绪');\r\n        \";\r\n    }\r\n\r\n    private string GetDomControlScript() {\r\n        var script = new StringBuilder();\r\n        script.AppendLine(\"window.DoubaoBridge = {\");\r\n        \r\n        // uploadImage function\r\n        script.AppendLine(\"    uploadImage: async function(base64Data, filename) {\");\r\n        script.AppendLine(\"        try {\");\r\n        script.AppendLine(\"            window.chrome.webview.postMessage('[LOG] 开始处理图片上传');\");\r\n        script.AppendLine(\"            const parts = base64Data.split(',');\");\r\n        script.AppendLine(\"            const mimeType = parts[0].match(/:(.*?);/)[1];\");\r\n        script.AppendLine(\"            const byteString = atob(parts[1]);\");\r\n        script.AppendLine(\"            const ab = new ArrayBuffer(byteString.length);\");\r\n        script.AppendLine(\"            const ia = new Uint8Array(ab);\");\r\n        script.AppendLine(\"            for (let i = 0; i < byteString.length; i++) {\");\r\n        script.AppendLine(\"                ia[i] = byteString.charCodeAt(i);\");\r\n        script.AppendLine(\"            }\");\r\n        script.AppendLine(\"            const blob = new Blob([ab], { type: mimeType });\");\r\n        script.AppendLine(\"            const file = new File([blob], filename, { type: mimeType });\");\r\n        script.AppendLine(\"            const fileInput = document.querySelector('input[type=\\\"file\\\"].hidden')\");\r\n        script.AppendLine(\"                           || document.querySelector('input[type=\\\"file\\\"]');\");\r\n        script.AppendLine(\"            if (!fileInput) {\");\r\n        script.AppendLine(\"                window.chrome.webview.postMessage('[LOG] 错误: 未找到文件输入框');\");\r\n        script.AppendLine(\"                return false;\");\r\n        script.AppendLine(\"            }\");\r\n        script.AppendLine(\"            // 放开接受的文件类型，避免 accept 限制导致非图片文件被拒绝\");\r\n        script.AppendLine(\"            try { fileInput.setAttribute('accept', '*/*'); } catch (e) {}\");\r\n        script.AppendLine(\"            const dataTransfer = new DataTransfer();\");\r\n        script.AppendLine(\"            dataTransfer.items.add(file);\");\r\n        script.AppendLine(\"            fileInput.files = dataTransfer.files;\");\r\n        script.AppendLine(\"            fileInput.dispatchEvent(new Event('change', { bubbles: true }));\");\r\n        script.AppendLine(\"            fileInput.dispatchEvent(new Event('input', { bubbles: true }));\");\r\n        script.AppendLine(\"            window.chrome.webview.postMessage('[LOG] 图片上传成功');\");\r\n        script.AppendLine(\"            return true;\");\r\n        script.AppendLine(\"        } catch (e) {\");\r\n        script.AppendLine(\"            window.chrome.webview.postMessage('[LOG] 图片上传错误: ' + e.message);\");\r\n        script.AppendLine(\"            return false;\");\r\n        script.AppendLine(\"        }\");\r\n        script.AppendLine(\"    },\");\r\n        \r\n        // newConversation function\r\n        script.AppendLine(\"    newConversation: async function() {\");\r\n        script.AppendLine(\"        try {\");\r\n        script.AppendLine(\"            window.chrome.webview.postMessage('[LOG] 开始新建对话');\");\r\n        script.AppendLine(\"            const allButtons = Array.from(document.querySelectorAll('button'));\");\r\n        script.AppendLine(\"            let newChatBtn = null;\");\r\n        script.AppendLine(\"            for (const btn of allButtons) {\");\r\n        script.AppendLine(\"                if (btn.textContent && btn.textContent.includes('新对话')) {\");\r\n        script.AppendLine(\"                    newChatBtn = btn;\");\r\n        script.AppendLine(\"                    window.chrome.webview.postMessage('[LOG] 通过文本找到新对话按钮');\");\r\n        script.AppendLine(\"                    break;\");\r\n        script.AppendLine(\"                }\");\r\n        script.AppendLine(\"            }\");\r\n        script.AppendLine(\"            if (!newChatBtn) {\");\r\n        script.AppendLine(\"                newChatBtn = document.querySelector('button.create-chat-IyaDB3')\");\r\n        script.AppendLine(\"                               || document.querySelector('[class*=\\\"create-chat\\\"]')\");\r\n        script.AppendLine(\"                               || document.querySelector('[class*=\\\"py-\\\"][class*=\\\"pl-\\\"][class*=\\\"pr-\\\"]');\");\r\n        script.AppendLine(\"            }\");\r\n        script.AppendLine(\"            if (newChatBtn) {\");\r\n        script.AppendLine(\"                window.chrome.webview.postMessage('[LOG] 找到新建对话按钮，点击中...');\");\r\n        script.AppendLine(\"                newChatBtn.click();\");\r\n        script.AppendLine(\"                await new Promise(resolve => setTimeout(resolve, 1500));\");\r\n        script.AppendLine(\"                window.chrome.webview.postMessage('[LOG] 新建对话完成');\");\r\n        script.AppendLine(\"                return true;\");\r\n        script.AppendLine(\"            } else {\");\r\n        script.AppendLine(\"                window.chrome.webview.postMessage('[LOG] 未找到新建对话按钮，尝试导航到聊天页面');\");\r\n        script.AppendLine(\"                window.location.href = 'https://www.doubao.com/chat/';\");\r\n        script.AppendLine(\"                await new Promise(resolve => setTimeout(resolve, 2500));\");\r\n        script.AppendLine(\"                window.chrome.webview.postMessage('[LOG] 页面导航完成');\");\r\n        script.AppendLine(\"                return true;\");\r\n        script.AppendLine(\"            }\");\r\n        script.AppendLine(\"        } catch (e) {\");\r\n        script.AppendLine(\"            window.chrome.webview.postMessage('[LOG] 新建对话失败: ' + e.message);\");\r\n        script.AppendLine(\"            return false;\");\r\n        script.AppendLine(\"        }\");\r\n        script.AppendLine(\"    },\");\r\n        \r\n        // sendPrompt function\r\n        script.AppendLine(\"    sendPrompt: function(text) {\");\r\n        script.AppendLine(\"        let input = document.querySelector('textarea[placeholder*=\\\"输入\\\"]')\");\r\n        script.AppendLine(\"                 || document.querySelector('textarea[placeholder*=\\\"问\\\"]');\");\r\n        script.AppendLine(\"        if (!input) {\");\r\n        script.AppendLine(\"            window.chrome.webview.postMessage('[LOG] 错误: 未找到输入框');\");\r\n        script.AppendLine(\"            return;\");\r\n        script.AppendLine(\"        }\");\r\n        script.AppendLine(\"        const nativeSetter = Object.getOwnPropertyDescriptor(window.HTMLTextAreaElement.prototype, 'value').set;\");\r\n        script.AppendLine(\"        nativeSetter.call(input, text);\");\r\n        script.AppendLine(\"        input.dispatchEvent(new Event('input', { bubbles: true }));\");\r\n        script.AppendLine(\"        input.focus();\");\r\n        script.AppendLine(\"        const findSendButton = () => {\");\r\n        script.AppendLine(\"            let btn = document.querySelector('button[type=\\\"submit\\\"]');\");\r\n        script.AppendLine(\"            if (btn && !btn.disabled) return btn;\");\r\n        script.AppendLine(\"            btn = document.querySelector('button[aria-label*=\\\"发送\\\"]');\");\r\n        script.AppendLine(\"            if (btn && !btn.disabled) return btn;\");\r\n        script.AppendLine(\"            const allButtons = Array.from(document.querySelectorAll('button'));\");\r\n        script.AppendLine(\"            const enabledButtons = allButtons.filter(b => !b.disabled && b.offsetParent !== null);\");\r\n        script.AppendLine(\"            return enabledButtons.length > 0 ? enabledButtons[enabledButtons.length - 1] : null;\");\r\n        script.AppendLine(\"        };\");\r\n        script.AppendLine(\"        const clickButton = (retryCount = 0) => {\");\r\n        script.AppendLine(\"            const maxRetries = 3;\");\r\n        script.AppendLine(\"            const sendBtn = findSendButton();\");\r\n        script.AppendLine(\"            if (sendBtn) {\");\r\n        script.AppendLine(\"                window.chrome.webview.postMessage('[LOG] 点击发送按钮');\");\r\n        script.AppendLine(\"                sendBtn.click();\");\r\n        script.AppendLine(\"                setTimeout(() => {\");\r\n        script.AppendLine(\"                    if (input.value.length > 0 && retryCount < maxRetries) {\");\r\n        script.AppendLine(\"                        window.chrome.webview.postMessage('[LOG] 发送失败，500ms后重试...');\");\r\n        script.AppendLine(\"                        setTimeout(() => clickButton(retryCount + 1), 500);\");\r\n        script.AppendLine(\"                    } else if (input.value.length === 0) {\");\r\n        script.AppendLine(\"                        window.chrome.webview.postMessage('[LOG] ✅ 发送成功！');\");\r\n        script.AppendLine(\"                    } else {\");\r\n        script.AppendLine(\"                        window.chrome.webview.postMessage('[LOG] ⚠️ 多次重试后仍失败');\");\r\n        script.AppendLine(\"                    }\");\r\n        script.AppendLine(\"                }, 300);\");\r\n        script.AppendLine(\"            } else {\");\r\n        script.AppendLine(\"                if (retryCount < maxRetries) {\");\r\n        script.AppendLine(\"                    window.chrome.webview.postMessage('[LOG] 未找到按钮，500ms后重试...');\");\r\n        script.AppendLine(\"                    setTimeout(() => clickButton(retryCount + 1), 500);\");\r\n        script.AppendLine(\"                } else {\");\r\n        script.AppendLine(\"                    window.chrome.webview.postMessage('[LOG] ❌ 找不到发送按钮');\");\r\n        script.AppendLine(\"                }\");\r\n        script.AppendLine(\"            }\");\r\n        script.AppendLine(\"        };\");\r\n        script.AppendLine(\"        setTimeout(() => {\");\r\n        script.AppendLine(\"            window.chrome.webview.postMessage('[LOG] 尝试: 按Enter键');\");\r\n        script.AppendLine(\"            input.dispatchEvent(new KeyboardEvent('keydown', {\");\r\n        script.AppendLine(\"                key: 'Enter', code: 'Enter', keyCode: 13, which: 13, bubbles: true\");\r\n        script.AppendLine(\"            }));\");\r\n        script.AppendLine(\"            setTimeout(() => {\");\r\n        script.AppendLine(\"                if (input.value.length > 0) {\");\r\n        script.AppendLine(\"                    window.chrome.webview.postMessage('[LOG] Enter无效，切换到点击模式');\");\r\n        script.AppendLine(\"                    clickButton(0);\");\r\n        script.AppendLine(\"                } else {\");\r\n        script.AppendLine(\"                    window.chrome.webview.postMessage('[LOG] ✅ Enter键成功');\");\r\n        script.AppendLine(\"                }\");\r\n        script.AppendLine(\"            }, 300);\");\r\n        script.AppendLine(\"        }, 100);\");\r\n        script.AppendLine(\"    }\");\r\n        script.AppendLine(\"};\");\r\n        \r\n        return script.ToString();\r\n    }\r\n}\r\n"
        },
