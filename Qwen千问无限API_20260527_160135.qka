    {
      "StepRunnerKey": "sys:csscript",
      "InputParams": {
        "mode": {
          "VarKey": null,
          "Value": "normal_roslyn"
        },
        "script": {
          "VarKey": null,
          "Value": "//css_ref System.Windows.Forms.dll\r\n//css_ref System.Drawing.dll\r\n\r\n\r\nusing System;\r\nusing System.IO;\r\nusing System.Net;\r\nusing System.Text;\r\nusing System.Threading.Tasks;\r\nusing System.Collections.Generic;\r\nusing System.Linq;\r\nusing System.Text.RegularExpressions;\r\nusing System.Windows.Forms; \r\nusing System.Drawing;\r\nusing System.Runtime.InteropServices;\r\nusing Microsoft.Web.WebView2.Core;\r\n\r\npublic static void Exec(Quicker.Public.IStepContext context)\r\n{\r\n    // 检查线程模式\r\n    if (System.Threading.Thread.CurrentThread.GetApartmentState() != System.Threading.ApartmentState.STA)\r\n    {\r\n        MessageBox.Show(\"错误：请将【执行线程】设置为【后台线程 (STA独立线程)】\");\r\n        return;\r\n    }\r\n\r\n    // [V16] 智能参数解析\r\n    string inputParam = \"\";\r\n    try { inputParam = context.GetVarValue(\"input\") as string; } catch { }\r\n    inputParam = inputParam?.Trim().ToLower() ?? \"\";\r\n\r\n    // 模式 1: 停止服务\r\n    if (inputParam == \"shutdown\" || inputParam == \"stop\")\r\n    {\r\n        ShutdownRemoteService();\r\n        return; \r\n    }\r\n\r\n    // 模式 2: 静默启动\r\n    bool isSilent = inputParam == \"silent\";\r\n\r\n    // V20: WinForms 初始化\r\n    Application.EnableVisualStyles();\r\n    Application.SetCompatibleTextRenderingDefault(false);\r\n    YuanbaoForm form = new YuanbaoForm(isSilent);\r\n    Application.Run(form);\r\n}\r\n\r\n// 远程关闭辅助函数\r\nprivate static void ShutdownRemoteService()\r\n{\r\n    try \r\n    {\r\n        var request = WebRequest.Create(\"http://127.0.0.1:57777/shutdown\");\r\n        request.Timeout = 2000; \r\n        using(var response = request.GetResponse()) { }\r\n        MessageBox.Show(\"✅ 已发送停止指令，后台服务即将关闭。\", \"Tongyi Relay\");\r\n    }\r\n    catch (WebException)\r\n    {\r\n        MessageBox.Show(\"⚠️ 无法连接到服务。\\n可能是服务未运行，或者端口不是 57777。\", \"停止失败\");\r\n    }\r\n    catch (Exception ex)\r\n    {\r\n        MessageBox.Show($\"❌ 发送指令出错: {ex.Message}\", \"错误\");\r\n    }\r\n}\r\n\r\npublic class YuanbaoForm : Form\r\n{\r\n    // V22.5: Win32 API - 手动控制RichTextBox滚动\r\n    [DllImport(\"user32.dll\")]\r\n    private static extern int SendMessage(IntPtr hWnd, int wMsg, int wParam, int lParam);\r\n    private const int WM_VSCROLL = 0x115;\r\n    private const int SB_LINEDOWN = 1;\r\n    private const int SB_LINEUP = 0;\r\n    \r\n    // ================= 配置区域 =================\r\n    private readonly bool _isDebugMode; \r\n    \r\n    private const string TargetUrl = \"https://tongyi.aliyun.com/qianwen\";\r\n    private const int ServerPort = 57777;  \r\n    private readonly string _userDataFolder = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments), \"Tongyi_Quicker_Data\");\r\n    private const string IconUrl = \"https://files.getquicker.net/_icons/A79F41249974B799C815B80CF149D5C04CA4DDBE.png\";\r\n\r\n    private CoreWebView2Environment _env;\r\n    private CoreWebView2Controller _controller;\r\n    private CoreWebView2 _coreWebView;\r\n    private bool _controllerAvailable = false; // V22.2: 控制器可用性标志\r\n    \r\n    private RichTextBox _txtLog;\r\n    private VScrollBar _customScrollBar; // V22.3: 自定义滚动条\r\n    private bool _updatingScrollBar = false; // V22.3: 防止滚动条递归更新\r\n    private SplitContainer _splitContainer; // V22.4: 保存分割容器引用\r\n    private Button _btnToggle;\r\n    private Label _lblStatus;\r\n    private Panel _rightPanel;\r\n    private Panel _webPanel;\r\n    \r\n    private HttpListener _httpListener;\r\n    private HttpListenerContext _currentContext;\r\n    private bool _isCurrentRequestStreaming;\r\n    private bool _isFinishing = false;\r\n    private StringBuilder _networkBuffer = new StringBuilder();\r\n    \r\n    private string _lastEventType = \"\";\r\n    \r\n    // V20新增：托盘和引用来源\r\n    private NotifyIcon _notifyIcon;\r\n    private ContextMenuStrip _trayMenu;\r\n    private List<string> _citations = new List<string>(); \r\n\r\n    public YuanbaoForm(bool isSilent)\r\n    {\r\n        _isDebugMode = !isSilent; \r\n        InitializeComponent();\r\n        InitializeSystemTray(); \r\n        \r\n        this.Load += async (s, e) => {\r\n            await LoadCustomIconAsync();\r\n            await InitializeCoreWebView2Async();\r\n            // V22.4: 窗口加载后重新计算分割距离，确保右侧面板宽度正确\r\n            if (_splitContainer != null) {\r\n                //右侧面板宽度 30%\r\n                _splitContainer.SplitterDistance = (int)(this.ClientSize.Width * 0.70);\r\n            }\r\n            // V22.5: 初始化自定义滚动条\r\n            UpdateCustomScrollBar();\r\n        };\r\n        this.Resize += (s, e) => {\r\n            ResizeWebView();\r\n            // V22.4: 窗口调整大小时保持比例\r\n            if (_splitContainer != null && this.ClientSize.Width > 0) {\r\n                //右侧面板宽度 30%\r\n                _splitContainer.SplitterDistance = (int)(this.ClientSize.Width * 0.70);\r\n            }\r\n        };\r\n        this.VisibleChanged += (s, e) => {\r\n            // V22.1: 窗口可见性变化时安全刷新WebView\r\n            if (this.Visible && _controller != null) {\r\n                Task.Delay(100).ContinueWith(_ => {\r\n                    try {\r\n                        if (this.InvokeRequired) {\r\n                            this.Invoke(new Action(() => {\r\n                                if (_controller != null) {\r\n                                    ResizeWebView();\r\n                                }\r\n                            }));\r\n                        } else {\r\n                            if (_controller != null) {\r\n                                ResizeWebView();\r\n                            }\r\n                        }\r\n                    } catch { /* 窗口可能已关闭 */ }\r\n                });\r\n            }\r\n        };\r\n        \r\n        StartHttpServer(); \r\n    }\r\n\r\n    protected override void OnFormClosing(FormClosingEventArgs e)\r\n    {\r\n        base.OnFormClosing(e);\r\n        _controllerAvailable = false; // V22.2: 标记控制器不可用\r\n        StopHttpServer();\r\n        \r\n        // V20: 释放托盘资源\r\n        if (_notifyIcon != null) {\r\n            _notifyIcon.Visible = false;\r\n            _notifyIcon.Dispose();\r\n        }\r\n    }\r\n\r\n    // V20：初始化系统托盘\r\n    private void InitializeSystemTray()\r\n    {\r\n        _trayMenu = new ContextMenuStrip();\r\n        _trayMenu.Items.Add(\"显示/隐藏控制台\", null, (s, e) => ToggleWindowVisibility());\r\n        _trayMenu.Items.Add(new ToolStripSeparator());\r\n        _trayMenu.Items.Add(\"退出服务\", null, (s, e) => this.Close());\r\n\r\n        _notifyIcon = new NotifyIcon();\r\n        _notifyIcon.Text = \"Tongyi Relay Service\";\r\n        _notifyIcon.Icon = SystemIcons.Application; // 默认图标，稍后替换\r\n        _notifyIcon.ContextMenuStrip = _trayMenu;\r\n        _notifyIcon.Visible = true;\r\n        _notifyIcon.DoubleClick += (s, e) => ToggleWindowVisibility();\r\n    }\r\n\r\n    // V20: 异步加载自定义图标\r\n    private async Task LoadCustomIconAsync()\r\n    {\r\n        try {\r\n            using (var client = new WebClient())\r\n            {\r\n                byte[] data = await client.DownloadDataTaskAsync(IconUrl);\r\n                using (var ms = new MemoryStream(data))\r\n                using (var bmp = new Bitmap(ms))\r\n                {\r\n                    var icon = Icon.FromHandle(bmp.GetHicon());\r\n                    this.Icon = icon;\r\n                    _notifyIcon.Icon = icon;\r\n                }\r\n            }\r\n        } catch { /* 图标下载失败忽略，使用默认 */ }\r\n    }\r\n\r\n    // V22.1: 安全的切换可见性 (修复控制器访问错误)\r\n    private void ToggleWindowVisibility()\r\n    {\r\n        if (this.Opacity < 1)\r\n        {\r\n            // 显示：先移回屏幕，再恢复透明度\r\n            if (this.Left < -10000) {\r\n                this.Location = new Point(100, 100);\r\n                this.CenterToScreen();\r\n            }\r\n            this.WindowState = FormWindowState.Normal;\r\n            this.ShowInTaskbar = true;\r\n            this.Opacity = 1;\r\n            this.BringToFront();\r\n            this.Activate();\r\n            \r\n            // V22.1: 延迟刷新WebView，避免黑屏\r\n            if (_controller != null && _webPanel != null) {\r\n                Task.Run(async () => {\r\n                    await Task.Delay(100);\r\n                    try {\r\n                        if (this.InvokeRequired) {\r\n                            this.Invoke(new Action(() => {\r\n                                try {\r\n                                    if (_controller != null && _webPanel != null && !_webPanel.IsDisposed) {\r\n                                        _webPanel.Invalidate();\r\n                                        _webPanel.Refresh();\r\n                                        ResizeWebView();\r\n                                        // 二次刷新确保完全显示\r\n                                        Task.Delay(150).ContinueWith(_ => {\r\n                                            try {\r\n                                                if (this.InvokeRequired) {\r\n                                                    this.Invoke(new Action(() => ResizeWebView()));\r\n                                                }\r\n                                            } catch { /* 忽略二次刷新错误 */ }\r\n                                        });\r\n                                    }\r\n                                } catch { /* 控制器可能处于过渡状态 */ }\r\n                            }));\r\n                        }\r\n                    } catch { /* 窗口可能已关闭 */ }\r\n                });\r\n            }\r\n        }\r\n        else\r\n        {\r\n            // 隐藏：移出屏幕，设为透明\r\n            this.Opacity = 0.01;\r\n            this.ShowInTaskbar = false;\r\n            this.Location = new Point(-32000, -32000);\r\n        }\r\n    }\r\n\r\n    private void InitializeComponent()\r\n    {\r\n        this.Text = $\"阿里通义千问 Relay V22.6 (Port: {ServerPort})\";\r\n        this.Size = new Size(1600, 800);\r\n        this.StartPosition = FormStartPosition.CenterScreen;\r\n        this.BackColor = Color.FromArgb(30, 30, 30);\r\n        this.FormBorderStyle = FormBorderStyle.Sizable; \r\n\r\n        if (_isDebugMode)\r\n        {\r\n            this.ShowInTaskbar = true;\r\n        }\r\n        else\r\n        {\r\n            this.ShowInTaskbar = false;\r\n            this.Opacity = 0.01;\r\n            this.StartPosition = FormStartPosition.Manual;\r\n            this.Location = new Point(-32000, -32000);\r\n        }\r\n\r\n        _splitContainer = new SplitContainer();\r\n        _splitContainer.Dock = DockStyle.Fill;\r\n        _splitContainer.Orientation = Orientation.Vertical;\r\n        _splitContainer.SplitterDistance = 300; // V22.4: 初始值，窗口加载后会重新计算\r\n        _splitContainer.BackColor = Color.FromArgb(45, 45, 48);\r\n        this.Controls.Add(_splitContainer);\r\n\r\n        _webPanel = new Panel();\r\n        _webPanel.Dock = DockStyle.Fill;\r\n        _webPanel.BackColor = Color.Black;\r\n        _splitContainer.Panel1.Controls.Add(_webPanel);\r\n        _webPanel.Resize += (s, e) => ResizeWebView();\r\n\r\n        _rightPanel = _splitContainer.Panel2;\r\n        _rightPanel.Padding = new Padding(10);\r\n        _rightPanel.BackColor = Color.FromArgb(30, 30, 30);\r\n\r\n        _btnToggle = new Button();\r\n        _btnToggle.Text = \"⏸ 停止 HTTP 服务\";\r\n        _btnToggle.Height = 50;\r\n        _btnToggle.Dock = DockStyle.Bottom;\r\n        _btnToggle.BackColor = Color.FromArgb(220, 53, 69); // 现代红色\r\n        _btnToggle.ForeColor = Color.White;\r\n        _btnToggle.FlatStyle = FlatStyle.Flat;\r\n        _btnToggle.FlatAppearance.BorderSize = 0;\r\n        _btnToggle.FlatAppearance.MouseOverBackColor = Color.FromArgb(200, 35, 51);\r\n        _btnToggle.FlatAppearance.MouseDownBackColor = Color.FromArgb(180, 25, 41);\r\n        _btnToggle.Font = new Font(\"Microsoft YaHei UI\", 10F, FontStyle.Bold);\r\n        _btnToggle.Cursor = Cursors.Hand;\r\n        _btnToggle.Click += (s, e) => ToggleService();\r\n        _rightPanel.Controls.Add(_btnToggle);\r\n\r\n        var infoPanel = new Panel();\r\n        infoPanel.Height = 220;\r\n        infoPanel.Dock = DockStyle.Top;\r\n        \r\n        var lblTitle = new Label { Text = \"阿里通义千问 Relay\", Font = new Font(\"Microsoft YaHei\", 14, FontStyle.Bold), ForeColor = Color.CornflowerBlue, AutoSize = true, Location = new Point(0, 0) };\r\n        infoPanel.Controls.Add(lblTitle);\r\n\r\n        _lblStatus = new Label { Text = \"✅ 正在运行\", ForeColor = Color.LightGreen, AutoSize = true, Location = new Point(0, 40) };\r\n        infoPanel.Controls.Add(_lblStatus);\r\n\r\n        infoPanel.Controls.Add(CreateLabel(\"API 地址:\", 70));\r\n        infoPanel.Controls.Add(CreateTextBox($\"http://127.0.0.1:{ServerPort}\", 90));\r\n        infoPanel.Controls.Add(CreateLabel(\"兼容端点:\", 120));\r\n        infoPanel.Controls.Add(CreateTextBox(\"/v1/chat/completions\", 140));\r\n        infoPanel.Controls.Add(CreateLabel(\"状态:\", 170));\r\n        infoPanel.Controls.Add(CreateTextBox(\"V22.6 (Anti-Detection Enhanced)\", 190));\r\n\r\n        _rightPanel.Controls.Add(infoPanel);\r\n\r\n        // V22.3: 使用RichTextBox + 自定义细滚动条\r\n        var logContainer = new Panel();\r\n        logContainer.Dock = DockStyle.Fill;\r\n        logContainer.Padding = new Padding(0, 10, 0, 10);\r\n        logContainer.BackColor = Color.FromArgb(30, 30, 30);\r\n        \r\n        _txtLog = new RichTextBox();\r\n        _txtLog.Dock = DockStyle.Fill;\r\n        _txtLog.BackColor = Color.FromArgb(30, 30, 30);\r\n        _txtLog.ForeColor = Color.FromArgb(220, 220, 220);\r\n        _txtLog.ReadOnly = true;\r\n        _txtLog.BorderStyle = BorderStyle.None;\r\n        _txtLog.Font = new Font(\"Consolas\", 9.5F, FontStyle.Regular);\r\n        _txtLog.WordWrap = false;\r\n        _txtLog.ScrollBars = RichTextBoxScrollBars.None; // V22.5: 完全禁用系统滚动条\r\n        _txtLog.DetectUrls = false;\r\n        _txtLog.Padding = new Padding(0, 0, 10, 0); // V22.5: 留出滚动条空间\r\n        _txtLog.TextChanged += (s, e) => UpdateCustomScrollBar();\r\n        _txtLog.Resize += (s, e) => UpdateCustomScrollBar();\r\n        // V22.5: 手动处理鼠标滚轮，控制滚动\r\n        _txtLog.MouseWheel += (s, e) => {\r\n            if (_txtLog.Lines.Length == 0) return;\r\n            // 根据滚轮方向滚动\r\n            int scrollLines = e.Delta / 120 * 3; // 每次滚动3行\r\n            for (int i = 0; i < Math.Abs(scrollLines); i++) {\r\n                SendMessage(_txtLog.Handle, WM_VSCROLL, scrollLines > 0 ? SB_LINEUP : SB_LINEDOWN, 0);\r\n            }\r\n            UpdateCustomScrollBar();\r\n        };\r\n        \r\n        // V22.3: 自定义细滚动条（8px宽）\r\n        _customScrollBar = new VScrollBar();\r\n        _customScrollBar.Dock = DockStyle.Right;\r\n        _customScrollBar.Width = 8;\r\n        _customScrollBar.BackColor = Color.FromArgb(45, 45, 48); // 深色背景\r\n        _customScrollBar.Cursor = Cursors.Hand;\r\n        _customScrollBar.Scroll += (s, e) => {\r\n            if (_txtLog.Lines.Length > 0) {\r\n                int targetLine = _customScrollBar.Value;\r\n                int charIndex = _txtLog.GetFirstCharIndexFromLine(targetLine);\r\n                if (charIndex >= 0) {\r\n                    _txtLog.SelectionStart = charIndex;\r\n                    _txtLog.ScrollToCaret();\r\n                }\r\n            }\r\n        };\r\n        \r\n        logContainer.Controls.Add(_txtLog);\r\n        logContainer.Controls.Add(_customScrollBar);\r\n        _rightPanel.Controls.Add(logContainer);\r\n        \r\n        logContainer.BringToFront();\r\n    }\r\n\r\n    private Label CreateLabel(string text, int y) {\r\n        return new Label { Text = text, ForeColor = Color.Gray, Location = new Point(0, y), AutoSize = true };\r\n    }\r\n    \r\n    private TextBox CreateTextBox(string text, int y) {\r\n        return new TextBox { Text = text, ReadOnly = true, BackColor = Color.FromArgb(30,30,30), ForeColor = Color.White, Location = new Point(0, y), Width = 280, BorderStyle = BorderStyle.None };\r\n    }\r\n\r\n    private void ToggleService()\r\n    {\r\n        if (_httpListener != null && _httpListener.IsListening) {\r\n            StopHttpServer();\r\n            _btnToggle.Text = \"▶ 启动 HTTP 服务\";\r\n            _btnToggle.BackColor = Color.FromArgb(40, 167, 69); // 绿色\r\n            _btnToggle.FlatAppearance.MouseOverBackColor = Color.FromArgb(33, 136, 56);\r\n            _btnToggle.FlatAppearance.MouseDownBackColor = Color.FromArgb(25, 110, 45);\r\n            _lblStatus.Text = \"⏸ 已停止\";\r\n            _lblStatus.ForeColor = Color.Orange;\r\n            Log(\"服务已手动停止\");\r\n        } else {\r\n            StartHttpServer();\r\n            _btnToggle.Text = \"⏸ 停止 HTTP 服务\";\r\n            _btnToggle.BackColor = Color.FromArgb(220, 53, 69); // 红色\r\n            _btnToggle.FlatAppearance.MouseOverBackColor = Color.FromArgb(200, 35, 51);\r\n            _btnToggle.FlatAppearance.MouseDownBackColor = Color.FromArgb(180, 25, 41);\r\n            _lblStatus.Text = \"✅ 正在运行\";\r\n            _lblStatus.ForeColor = Color.LightGreen;\r\n            Log(\"服务已手动启动\");\r\n        }\r\n    }\r\n\r\n    private async Task InitializeCoreWebView2Async()\r\n    {\r\n        try {\r\n            _env = await CoreWebView2Environment.CreateAsync(null, _userDataFolder);\r\n            _controller = await _env.CreateCoreWebView2ControllerAsync(_webPanel.Handle);\r\n            _coreWebView = _controller.CoreWebView2;\r\n            _controllerAvailable = true; // V22.2: 标记控制器可用\r\n            ResizeWebView();\r\n\r\n            // ✅ 【关键】设置真实浏览器 User-Agent\r\n            _coreWebView.Settings.UserAgent = \r\n                \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.6367.78 Safari/537.36\";\r\n\r\n            // ✅ 【关键】隐藏 webdriver 标志\r\n            await _coreWebView.ExecuteScriptAsync(@\"\r\n                // 删除 webdriver 标志\r\n                Object.defineProperty(navigator, 'webdriver', {\r\n                    get: () => undefined,\r\n                });\r\n                \r\n                // 删除 webkit 标志\r\n                delete navigator.__proto__.webdriver;\r\n                \r\n                // 添加真实浏览器特征\r\n                Object.defineProperty(navigator, 'plugins', {\r\n                    get: () => [1, 2, 3, 4, 5],\r\n                });\r\n                \r\n                Object.defineProperty(navigator, 'languages', {\r\n                    get: () => ['zh-CN', 'zh', 'en'],\r\n                });\r\n            \");\r\n\r\n            await _coreWebView.AddScriptToExecuteOnDocumentCreatedAsync(GetNetworkInterceptorScript());\r\n            _coreWebView.WebMessageReceived += OnWebMessageReceived;\r\n            _coreWebView.NavigationCompleted += async (s, e) => {\r\n                if (e.IsSuccess) {\r\n                    // ✅ 【关键】在页面加载完成后再次伪装\r\n                    await _coreWebView.ExecuteScriptAsync(@\"\r\n                        // 再次确保 webdriver 为 false\r\n                        if (window.navigator && window.navigator.__proto__) {\r\n                            delete window.navigator.__proto__.webdriver;\r\n                        }\r\n                        \r\n                        // 模拟真实用户行为\r\n                        window.dispatchEvent(new Event('load'));\r\n                        window.dispatchEvent(new Event('DOMContentLoaded'));\r\n                        \r\n                        // 确保页面完全加载后才继续\r\n                        if (document.readyState !== 'complete') {\r\n                            document.addEventListener('readystatechange', function() {\r\n                                if (document.readyState === 'complete') {\r\n                                    window.chrome.webview.postMessage('[LOG] ✅ 页面完全加载完成');\r\n                                }\r\n                            });\r\n                        } else {\r\n                            window.chrome.webview.postMessage('[LOG] ✅ 页面完全加载完成');\r\n                        }\r\n                    \");\r\n                    \r\n                    await _coreWebView.ExecuteScriptAsync(GetDomControlScript());\r\n                    Log(\"系统就绪 (V22.6)！\"); \r\n                }\r\n            };\r\n            _coreWebView.Navigate(TargetUrl);\r\n        } catch (Exception ex) { Log($\"CoreWebView2 Init Failed: {ex.Message}\"); }\r\n    }\r\n\r\n    private void ResizeWebView()\r\n    {\r\n        // V22.2: 先检查控制器是否可用，避免重复报错\r\n        if (!_controllerAvailable || _controller == null || _webPanel == null) return;\r\n        \r\n        try {\r\n            if (!_webPanel.IsDisposed && _webPanel.IsHandleCreated)\r\n            {\r\n                _controller.Bounds = new Rectangle(0, 0, _webPanel.Width, _webPanel.Height);\r\n            }\r\n        } catch (System.Runtime.InteropServices.COMException ex) { \r\n            // V22.2: COM异常说明控制器已不可用，标记并停止尝试\r\n            _controllerAvailable = false;\r\n            if (_isDebugMode) Log($\"[ResizeWebView] 控制器已不可用，停止调整: {ex.Message}\");\r\n        } catch (InvalidOperationException ex) {\r\n            // V22.2: 控制器已释放\r\n            _controllerAvailable = false;\r\n            if (_isDebugMode) Log($\"[ResizeWebView] 控制器已释放：{ex.Message}\");\r\n        } catch (Exception ex) { \r\n            if (_isDebugMode) Log($\"[ResizeWebView] 未知错误: {ex.Message}\");\r\n        }\r\n    }\r\n\r\n    private void StartHttpServer()\r\n    {\r\n        try {\r\n            if (_httpListener != null) StopHttpServer(); \r\n            _httpListener = new HttpListener();\r\n            _httpListener.Prefixes.Add($\"http://127.0.0.1:{ServerPort}/\");\r\n            _httpListener.Start();\r\n            Task.Run(ListenLoop);\r\n            Log($\"HTTP 服务监听中: {ServerPort}\");\r\n        } catch (Exception ex) { \r\n            Log($\"HTTP 启动失败: {ex.Message}\");\r\n        }\r\n    }\r\n\r\n    private void StopHttpServer()\r\n    {\r\n        try {\r\n            if (_httpListener != null) { _httpListener.Stop(); _httpListener.Close(); _httpListener = null; }\r\n        } catch { }\r\n    }\r\n\r\n    private async Task ListenLoop()\r\n    {\r\n        var listener = _httpListener;\r\n        if (listener == null) return;\r\n        while (listener != null && listener.IsListening) {\r\n            try { var context = await listener.GetContextAsync(); HandleRequest(context); } catch { break; }\r\n        }\r\n    }\r\n\r\n    private async void HandleRequest(HttpListenerContext ctx)\r\n    {\r\n        string path = ctx.Request.Url.AbsolutePath.ToLower();\r\n        string method = ctx.Request.HttpMethod.ToUpper();\r\n        ctx.Response.AppendHeader(\"Access-Control-Allow-Origin\", \"*\");\r\n        ctx.Response.AppendHeader(\"Access-Control-Allow-Methods\", \"POST, GET, OPTIONS\");\r\n        ctx.Response.AppendHeader(\"Access-Control-Allow-Headers\", \"Content-Type, Authorization\");\r\n\r\n        if (method == \"OPTIONS\") { ctx.Response.StatusCode = 200; ctx.Response.Close(); return; }\r\n\r\n        if (path == \"/shutdown\") {\r\n            ResponseText(ctx, \"正在关闭服务...\");\r\n            Task.Delay(1000).ContinueWith(_ => this.BeginInvoke(new Action(() => this.Close())));\r\n            return;\r\n        }\r\n\r\n        if ((path == \"/v1/chat/completions\" || path == \"/chat\") && method == \"POST\")\r\n        {\r\n            if (_currentContext != null) { \r\n                // 返回符合OpenAI API标准的错误格式\r\n                ResponseText(ctx, \"{\\\"error\\\":{\\\"message\\\":\\\"Service is busy, please try again later.\\\",\\\"type\\\":\\\"server_error\\\",\\\"code\\\":\\\"busy\\\"}}\", 429, \"application/json\"); \r\n                return; \r\n            }\r\n            try {\r\n                // [V17] 强制 UTF-8\r\n                using (var reader = new StreamReader(ctx.Request.InputStream, Encoding.UTF8)) {\r\n                    string body = reader.ReadToEnd();\r\n                    Log(\"收到请求\");\r\n                    bool isStream = body.Contains(\"\\\"stream\\\": true\") || body.Contains(\"\\\"stream\\\":true\");\r\n                    \r\n                    // [V17.1] 提取系统提示词 + 用户提示词\r\n                    string prompt = ExtractPromptFromJson(body);\r\n                    \r\n                    if (string.IsNullOrWhiteSpace(prompt)) {\r\n                        if (!body.Trim().StartsWith(\"{\")) prompt = body;\r\n                        else { \r\n                            ResponseText(ctx, \"{\\\"error\\\":{\\\"message\\\":\\\"Failed to parse request body\\\",\\\"type\\\":\\\"invalid_request_error\\\",\\\"code\\\":\\\"parse_error\\\"}}\", 400, \"application/json\"); \r\n                            return; \r\n                        }\r\n                    }\r\n                    _currentContext = ctx;\r\n                    _isCurrentRequestStreaming = isStream;\r\n                    _networkBuffer.Clear(); \r\n                    _lastEventType = \"\";\r\n                    _citations.Clear(); // V20: 清空引用来源 \r\n                    Log($\"[HandleRequest] 设置上下文 | 流式={isStream}\");\r\n\r\n                    if (isStream) {\r\n                        ctx.Response.StatusCode = 200;\r\n                        ctx.Response.ContentType = \"text/event-stream; charset=utf-8\";\r\n                        ctx.Response.AppendHeader(\"Cache-Control\", \"no-cache\");\r\n                        ctx.Response.AppendHeader(\"Connection\", \"keep-alive\");\r\n                        ctx.Response.AppendHeader(\"X-Accel-Buffering\", \"no\");\r\n                        ctx.Response.SendChunked = true;\r\n                        // 立即刷新响应头，确保客户端开始接收流\r\n                        ctx.Response.OutputStream.Flush();\r\n                        Log(\"[HandleRequest] ✓响应头已发送，等待元宝回复...\");\r\n                    } else { \r\n                        ctx.Response.ContentType = \"application/json\"; \r\n                    }\r\n                    await InjectPromptToWebView(prompt);\r\n                }\r\n            } catch (Exception ex) { \r\n                Log($\"Error: {ex.Message}\"); \r\n                ResponseText(ctx, $\"{{\\\"error\\\":{{\\\"message\\\":\\\"Internal server error: {EscapeJson(ex.Message)}\\\",\\\"type\\\":\\\"server_error\\\",\\\"code\\\":\\\"internal_error\\\"}}}}\", 500, \"application/json\");\r\n                if (_currentContext == ctx) CleanupRequest(); \r\n            }\r\n        } else { \r\n            ResponseText(ctx, \"{\\\"error\\\":{\\\"message\\\":\\\"Endpoint not found\\\",\\\"type\\\":\\\"invalid_request_error\\\",\\\"code\\\":\\\"not_found\\\"}}\", 404, \"application/json\"); \r\n        }\r\n    }\r\n\r\n    // [V17.1] 智能提取器：遍历所有消息，拼接 System + User\r\n    private string ExtractPromptFromJson(string json)\r\n    {\r\n        try {\r\n            string systemPrompt = \"\";\r\n            string userPrompt = \"\";\r\n\r\n            var roleRegex = new Regex(\"\\\"role\\\"\\\\s*:\\\\s*\\\"(system|user|assistant)\\\"\");\r\n            var contentRegex = new Regex(\"\\\"content\\\"\\\\s*:\\\\s*\\\"((?:[^\\\"\\\\\\\\]|\\\\\\\\.)*)\\\"\");\r\n\r\n            var roles = roleRegex.Matches(json).Cast<Match>().ToList();\r\n            var contents = contentRegex.Matches(json).Cast<Match>().ToList();\r\n\r\n            if (roles.Count > 0 && roles.Count == contents.Count)\r\n            {\r\n                for (int i = 0; i < roles.Count; i++)\r\n                {\r\n                    string r = roles[i].Groups[1].Value.ToLower();\r\n                    string c = UnescapeJson(contents[i].Groups[1].Value);\r\n\r\n                    if (r == \"system\") \r\n                    {\r\n                        systemPrompt += c + \"\\n\\n\";\r\n                    }\r\n                    else if (r == \"user\")\r\n                    {\r\n                        userPrompt = c;\r\n                    }\r\n                }\r\n            }\r\n            else\r\n            {\r\n                var lastMatch = contents.LastOrDefault();\r\n                if (lastMatch != null) userPrompt = UnescapeJson(lastMatch.Groups[1].Value);\r\n            }\r\n\r\n            string finalPrompt = \"\";\r\n            if (!string.IsNullOrWhiteSpace(systemPrompt)) \r\n            {\r\n                finalPrompt += \"[System Instructions]:\\n\" + systemPrompt.Trim() + \"\\n\\n[User Message]:\\n\";\r\n            }\r\n            finalPrompt += userPrompt;\r\n\r\n            return finalPrompt.Trim();\r\n        } \r\n        catch { return null; }\r\n    }\r\n\r\n    private async Task InjectPromptToWebView(string prompt)\r\n    {\r\n        try {\r\n            string escapedPrompt = prompt.Replace(\"\\\\\", \"\\\\\\\\\").Replace(\"\\\"\", \"\\\\\\\"\").Replace(\"\\r\", \"\").Replace(\"\\n\", \"\\\\n\");\r\n            string script = $\"window.TongyiBridge.sendPrompt(\\\"{escapedPrompt}\\\")\";\r\n            Log($\"[InjectPrompt] 准备执行 JavaScript, 内容长度: {prompt.Length}\");\r\n            \r\n            // 使用 Invoke 确保在 UI 线程执行\r\n            await Task.Run(() => {\r\n                if (this.InvokeRequired) {\r\n                    this.Invoke(new Action(async () => {\r\n                        try {\r\n                            // 先检查 TongyiBridge 是否存在\r\n                            string checkScript = \"typeof window.TongyiBridge !== 'undefined' && typeof window.TongyiBridge.sendPrompt === 'function'\";\r\n                            string checkResult = await _coreWebView.ExecuteScriptAsync(checkScript);\r\n                            Log($\"[InjectPrompt] TongyiBridge 检查结果: {checkResult}\");\r\n                            \r\n                            if (checkResult != \"true\") {\r\n                                Log(\"[InjectPrompt] ❌ 错误: TongyiBridge 尚未就绪\");\r\n                                return;\r\n                            }\r\n                            \r\n                            string result = await _coreWebView.ExecuteScriptAsync(script);\r\n                            Log($\"[InjectPrompt] ✓ JavaScript 执行成功，返回: {result}\");\r\n                        } catch (Exception ex) {\r\n                            Log($\"[InjectPrompt] ❌ UI线程执行失败: {ex.Message}\");\r\n                        }\r\n                    }));\r\n                }\r\n            });\r\n        } catch (Exception ex) {\r\n            Log($\"[InjectPrompt] ❌ JavaScript 执行失败: {ex.Message}\");\r\n        }\r\n    }\r\n\r\n    private void OnWebMessageReceived(object sender, CoreWebView2WebMessageReceivedEventArgs e)\r\n    {\r\n        try {\r\n            string msg = e.TryGetWebMessageAsString();\r\n            if (msg.StartsWith(\"[LOG]\")) { Log(msg); return; }\r\n            \r\n            // V19改进：调试模式下即使没有请求上下文也处理数据\r\n            if (_currentContext == null && !_isDebugMode) {\r\n                if (_isDebugMode) Log($\"[OnWebMessage] 无请求上下文，忽略消息: {msg.Substring(0, Math.Min(50, msg.Length))}...\");\r\n                return;\r\n            }\r\n            \r\n            if (msg.StartsWith(\"[NETWORK_DONE]\")) {\r\n                Log($\"[OnWebMessage] 收到 NETWORK_DONE | Context={(_currentContext == null ? \"null\" : \"有效\")}\"); \r\n                if (_currentContext != null) FinishRequest(); \r\n                return; \r\n            }\r\n            if (msg.StartsWith(\"[NETWORK_DATA]\")) { \r\n                string rawData = msg.Substring(14);\r\n                if (_isDebugMode) Log($\"[OnWebMessage] 收到数据块 ({rawData.Length} 字节) | Context={(_currentContext == null ? \"null\" : \"有效\")}\");\r\n                ProcessNetworkData(rawData); \r\n            }\r\n        } catch (Exception ex) { Log($\"MsgError: {ex.Message}\"); }\r\n    }\r\n\r\n    // ================== V18 核心: SSE 状态机解析（增强版） ==================\r\n    private void ProcessNetworkData(string rawChunk)\r\n    {\r\n        _networkBuffer.Append(rawChunk);\r\n        string bufferStr = _networkBuffer.ToString();\r\n\r\n        if (_isDebugMode && rawChunk.Length > 0) { \r\n             string debugSnippet = rawChunk.Length > 100 ? rawChunk.Substring(0, 100) + \"...\" : rawChunk;\r\n             Log($\"[RAW] {debugSnippet.Replace(\"\\n\", \"\\\\n\")} | Context={(_currentContext == null ? \"null\" : \"有效\")}\");\r\n        }\r\n\r\n        int lastNewLine = bufferStr.LastIndexOf('\\n');\r\n        if (lastNewLine == -1) {\r\n            if (_isDebugMode) Log($\"[ProcessNetworkData] 等待更多数据（缓冲区: {bufferStr.Length} 字节）\");\r\n            return;\r\n        } \r\n\r\n        string processablePart = bufferStr.Substring(0, lastNewLine + 1);\r\n        _networkBuffer.Remove(0, lastNewLine + 1);\r\n\r\n        using (StringReader reader = new StringReader(processablePart))\r\n        {\r\n            string line;\r\n            while ((line = reader.ReadLine()) != null)\r\n            {\r\n                if (string.IsNullOrWhiteSpace(line)) { _lastEventType = \"\"; continue; }\r\n                line = line.Trim();\r\n                if (line.StartsWith(\"event:\")) { \r\n                    _lastEventType = line.Substring(6).Trim(); \r\n                    if (_isDebugMode) Log($\"[EVENT] 事件类型: {_lastEventType}\");\r\n                }\r\n                else if (line.StartsWith(\"data:\"))\r\n                {\r\n                    string data = line.Substring(5).Trim();\r\n                    \r\n                    // 检测流结束标记\r\n                    if (data == \"[DONE]\" || data == \"\\\"[DONE]\\\"\")\r\n                    {\r\n                        if (_isDebugMode) Log($\"[SSE] 检测到 [DONE] 标记: '{data}', _currentContext={(_currentContext == null ? \"null\" : \"有效\")}\");\r\n                        if (_currentContext != null) {\r\n                            if (_isDebugMode) Log(\"[SSE] 准备调用 FinishRequest\");\r\n                            try {\r\n                                FinishRequest();\r\n                                if (_isDebugMode) Log(\"[SSE] FinishRequest 调用完成\");\r\n                            } catch (Exception ex) {\r\n                                if (_isDebugMode) Log($\"[SSE] ❌ FinishRequest 调用出错: {ex.Message}\");\r\n                            }\r\n                        } else {\r\n                            if (_isDebugMode) Log(\"[SSE] ⚠️ _currentContext 为 null，跳过 FinishRequest\");\r\n                        }\r\n                        return;\r\n                    }\r\n                    \r\n                    // [V18改进] 只过滤确定无用的事件类型，其他都尝试解析\r\n                    if (_lastEventType == \"title\" || _lastEventType == \"update_session\") { \r\n                        continue; \r\n                    }\r\n                    \r\n                    string json = data;\r\n                    \r\n                    // V20: 捕获搜索结果引用来源\r\n                    if (json.Contains(\"results\\\"\") && json.Contains(\"\\\"v\\\":\")) {\r\n                        try {\r\n                            var urlMatches = Regex.Matches(json, \"\\\"url\\\"\\\\s*:\\\\s*\\\"((?:[^\\\"\\\\\\\\]|\\\\\\\\.)*)\\\"\");\r\n                            var titleMatches = Regex.Matches(json, \"\\\"title\\\"\\\\s*:\\\\s*\\\"((?:[^\\\"\\\\\\\\]|\\\\\\\\.)*)\\\"\");\r\n                            int count = Math.Min(urlMatches.Count, titleMatches.Count);\r\n                            for (int i = 0; i < count; i++) {\r\n                                string url = UnescapeJson(urlMatches[i].Groups[1].Value);\r\n                                string title = UnescapeJson(titleMatches[i].Groups[1].Value);\r\n                                string citationEntry = $\"[{_citations.Count + 1}] [{title}]({url})\";\r\n                                if (!_citations.Contains(citationEntry)) {\r\n                                    _citations.Add(citationEntry);\r\n                                    if (_isDebugMode) Log($\"[Citation] 捕获引用: {title}\");\r\n                                }\r\n                            }\r\n                        } catch { }\r\n                        continue; // 跳过搜索结果数据，不发送给客户端\r\n                    }\r\n                    \r\n                    // 改进：优先提取阿里通义千问的响应字段\r\n                    string content = ExtractValueFromJson(json, \"content\");\r\n                    if (string.IsNullOrEmpty(content)) { content = ExtractValueFromJson(json, \"text\"); }\r\n                    if (string.IsNullOrEmpty(content)) { content = ExtractValueFromJson(json, \"msg\"); }\r\n                    if (string.IsNullOrEmpty(content)) { content = ExtractValueFromJson(json, \"v\"); }\r\n                    if (string.IsNullOrEmpty(content)) { content = ExtractValueFromJson(json, \"message\"); }\r\n                    if (string.IsNullOrEmpty(content)) { content = ExtractValueFromJson(json, \"delta\"); }\r\n                    if (string.IsNullOrEmpty(content)) { content = ExtractValueFromJson(json, \"answer\"); }\r\n                    if (string.IsNullOrEmpty(content)) { content = ExtractValueFromJson(json, \"result\"); }\r\n                    if (string.IsNullOrEmpty(content)) { content = ExtractValueFromJson(json, \"response\"); }\r\n                    \r\n                    if (!string.IsNullOrEmpty(content)) { SendDelta(content); }\r\n                }\r\n            }\r\n        }\r\n    }\r\n\r\n    private string ExtractValueFromJson(string json, string key)\r\n    {\r\n        var regex = new Regex($\"\\\"{key}\\\":\\\\s*\\\"((?:[^\\\"\\\\\\\\]|\\\\\\\\.)*)\\\"\");\r\n        var match = regex.Match(json);\r\n        if (match.Success) return UnescapeJson(match.Groups[1].Value);\r\n        return null;\r\n    }\r\n\r\n    private string UnescapeJson(string str)\r\n    {\r\n        return str.Replace(\"\\\\\\\"\", \"\\\"\").Replace(\"\\\\\\\\\", \"\\\\\").Replace(\"\\\\n\", \"\\n\").Replace(\"\\\\r\", \"\\r\").Replace(\"\\\\t\", \"\\t\");\r\n    }\r\n\r\n    private void SendDelta(string text)\r\n    {\r\n        if (_isCurrentRequestStreaming && _currentContext != null)\r\n        {\r\n            string jsonChunk = $\"{{\\\"id\\\":\\\"chatcmpl-tongyi\\\",\\\"object\\\":\\\"chat.completion.chunk\\\",\\\"created\\\":{DateTimeOffset.Now.ToUnixTimeSeconds()},\\\"model\\\":\\\"tongyi-chat\\\",\\\"choices\\\":[{{\\\"index\\\":0,\\\"delta\\\":{{\\\"content\\\":\\\"{EscapeJson(text)}\\\"}},\\\"finish_reason\\\":null}}]}}\";\r\n            WriteSseData($\"data: {jsonChunk}\\n\\n\");\r\n            if (_isDebugMode) Log($\"[✓发送] {text.Replace(\"\\n\", \"\\\\n\")}\");\r\n        }\r\n        else if (_currentContext == null)\r\n        {\r\n            Log($\"[WARN] 无活动请求上下文，丢弃数据: {text.Substring(0, Math.Min(50, text.Length))}...\");\r\n        }\r\n        else if (!_isCurrentRequestStreaming)\r\n        {\r\n            Log($\"[WARN] 非流式模式，丢弃数据: {text.Substring(0, Math.Min(50, text.Length))}...\");\r\n        }\r\n        if (!_isDebugMode) Log($\"[NET] {text.Replace(\"\\n\", \"\\\\n\")}\");\r\n    }\r\n\r\n    private void FinishRequest()\r\n    {\r\n        if (_isFinishing) { \r\n            if (_isDebugMode) Log(\"[FinishRequest] 已在处理中，跳过重复调用\"); \r\n            return; \r\n        }\r\n        _isFinishing = true;\r\n        Log(\"网络流结束\");\r\n        if (_networkBuffer.Length > 0) { ProcessNetworkData(\"\\n\"); _networkBuffer.Clear(); }\r\n        \r\n        // V20: 添加引用来源\r\n        if (_citations.Count > 0) {\r\n            StringBuilder sb = new StringBuilder();\r\n            sb.Append(\"\\n\\n**引用来源：**\\n\");\r\n            foreach (var cite in _citations) {\r\n                sb.Append(cite + \"\\n\");\r\n            }\r\n            SendDelta(sb.ToString());\r\n            if (_isDebugMode) Log($\"[FinishRequest] 添加了 {_citations.Count} 个引用来源\");\r\n        }\r\n        \r\n        if (_isCurrentRequestStreaming)\r\n        {\r\n            string stopChunk = $\"{{\\\"id\\\":\\\"chatcmpl-tongyi\\\",\\\"object\\\":\\\"chat.completion.chunk\\\",\\\"created\\\":{DateTimeOffset.Now.ToUnixTimeSeconds()},\\\"model\\\":\\\"tongyi-chat\\\",\\\"choices\\\":[{{\\\"index\\\":0,\\\"delta\\\":{{}},\\\"finish_reason\\\":\\\"stop\\\"}}]}}\";\r\n            WriteSseData($\"data: {stopChunk}\\n\\n\");\r\n            WriteSseData(\"data: [DONE]\\n\\n\");\r\n        }\r\n        else { \r\n            // 返回非流式响应的标准格式\r\n            string responseJson = $\"{{\\\"id\\\":\\\"chatcmpl-tongyi\\\",\\\"object\\\":\\\"chat.completion\\\",\\\"created\\\":{DateTimeOffset.Now.ToUnixTimeSeconds()},\\\"model\\\":\\\"tongyi-chat\\\",\\\"choices\\\":[{{\\\"index\\\":0,\\\"message\\\":{{\\\"role\\\":\\\"assistant\\\",\\\"content\\\":\\\"Stream mode is required for this service. Please set stream=true.\\\"}},\\\"finish_reason\\\":\\\"stop\\\"}}],\\\"usage\\\":{{\\\"prompt_tokens\\\":0,\\\"completion_tokens\\\":0,\\\"total_tokens\\\":0}}}}\";\r\n            ResponseText(_currentContext, responseJson, 200, \"application/json\"); \r\n        }\r\n        \r\n        // V17兼容：完成回复后清空输入框\r\n        _ = InjectPromptToWebView(\"\"); // 不阻塞，异步执行\r\n        \r\n        CleanupRequest();\r\n        _isFinishing = false;\r\n    }\r\n\r\n    private void WriteSseData(string data)\r\n    {\r\n        try {\r\n            byte[] buffer = Encoding.UTF8.GetBytes(data);\r\n            _currentContext.Response.OutputStream.Write(buffer, 0, buffer.Length);\r\n            _currentContext.Response.OutputStream.Flush();\r\n        } catch { CleanupRequest(); }\r\n    }\r\n\r\n    private void CleanupRequest()\r\n    {\r\n        try { _currentContext?.Response.Close(); } catch { }\r\n        _currentContext = null; _networkBuffer.Clear();\r\n    }\r\n\r\n    private void ResponseText(HttpListenerContext ctx, string text, int code = 200, string contentType = \"text/plain\")\r\n    {\r\n        try {\r\n            ctx.Response.StatusCode = code; \r\n            ctx.Response.ContentType = contentType;\r\n            byte[] buffer = Encoding.UTF8.GetBytes(text);\r\n            ctx.Response.ContentLength64 = buffer.Length;\r\n            ctx.Response.OutputStream.Write(buffer, 0, buffer.Length);\r\n            ctx.Response.Close();\r\n        } catch { }\r\n    }\r\n\r\n    private string EscapeJson(string s)\r\n    {\r\n        if (s == null) return \"\";\r\n        return s.Replace(\"\\\\\", \"\\\\\\\\\").Replace(\"\\\"\", \"\\\\\\\"\").Replace(\"\\n\", \"\\\\n\").Replace(\"\\r\", \"\\\\r\").Replace(\"\\t\", \"\\\\t\");\r\n    }\r\n\r\n    // V22.3: 更新自定义滚动条\r\n    private void UpdateCustomScrollBar()\r\n    {\r\n        if (_updatingScrollBar || _txtLog == null || _customScrollBar == null) return;\r\n        \r\n        _updatingScrollBar = true;\r\n        try {\r\n            int lineHeight = (int)_txtLog.Font.Height;\r\n            if (lineHeight <= 0) lineHeight = 14; // 默认行高\r\n            \r\n            int visibleLines = Math.Max(1, _txtLog.ClientSize.Height / lineHeight);\r\n            int totalLines = Math.Max(1, _txtLog.Lines.Length);\r\n            \r\n            if (totalLines > visibleLines) {\r\n                if (!_customScrollBar.Visible) _customScrollBar.Visible = true;\r\n                \r\n                _customScrollBar.Minimum = 0;\r\n                _customScrollBar.Maximum = totalLines - 1;\r\n                _customScrollBar.LargeChange = Math.Max(1, visibleLines);\r\n                _customScrollBar.SmallChange = 1;\r\n                \r\n                // 获取当前滚动位置\r\n                int firstVisibleLine = _txtLog.GetLineFromCharIndex(_txtLog.GetCharIndexFromPosition(new Point(1, 1)));\r\n                if (firstVisibleLine >= 0) {\r\n                    int maxValue = Math.Max(0, _customScrollBar.Maximum - _customScrollBar.LargeChange + 1);\r\n                    _customScrollBar.Value = Math.Min(Math.Max(0, firstVisibleLine), maxValue);\r\n                }\r\n            } else {\r\n                if (_customScrollBar.Visible) _customScrollBar.Visible = false;\r\n            }\r\n        } catch { \r\n            // 忽略滚动条更新错误\r\n        } finally {\r\n            _updatingScrollBar = false;\r\n        }\r\n    }\r\n\r\n    private void Log(string msg)\r\n    {\r\n        if (!_isDebugMode) return;\r\n        if (_txtLog != null && !_txtLog.IsDisposed) {\r\n            if (_txtLog.InvokeRequired) _txtLog.Invoke(new Action(() => Log(msg)));\r\n            else { \r\n                _txtLog.AppendText($\"[{DateTime.Now:HH:mm:ss}] {msg}\\r\\n\");\r\n                // V22.3: 自动滚动到底部\r\n                _txtLog.SelectionStart = _txtLog.Text.Length;\r\n                _txtLog.ScrollToCaret();\r\n                UpdateCustomScrollBar();\r\n            }\r\n        }\r\n    }\r\n\r\n    // ================== V18 增强版网络拦截器 ==================\r\n    private string GetNetworkInterceptorScript()\r\n    {\r\n        return @\"\r\n        window.chrome.webview.postMessage('[LOG] 🔧 网络拦截器正在挂载 (V22.6)...');\r\n        \r\n        const originalFetch = window.fetch;\r\n        window.fetch = async (...args) => {\r\n            let url = '';\r\n            try { \r\n                if (args[0] instanceof Request) url = args[0].url; \r\n                else url = args[0].toString(); \r\n            } catch(e) { url = 'unknown'; }\r\n            \r\n            // 改进：捕获阿里通义千问的API请求\r\n            const isTongyiRequest = url.indexOf('tongyi.aliyun.com') !== -1;\r\n            const isApiPath = url.indexOf('/api/') !== -1 || url.indexOf('/chat/') !== -1 || url.indexOf('/qianwen/') !== -1 || url.indexOf('/stream/') !== -1 || url.indexOf('/v1/') !== -1;\r\n            const isRelativeApi = url.startsWith('/api/') || url.startsWith('/chat/') || url.startsWith('/qianwen/') || url.startsWith('/stream/') || url.startsWith('/v1/');\r\n            const isStaticResource = url.match(/\\.(js|css|png|jpg|jpeg|gif|svg|woff|woff2|ttf|ico)$/);\r\n            \r\n            // 拦截阿里通义千问域名下的 API 请求，或相对路径的 API 请求\r\n            const shouldIntercept = !isStaticResource && (\r\n                isTongyiRequest ||\r\n                isRelativeApi\r\n            );\r\n            \r\n            if (shouldIntercept) {\r\n                window.chrome.webview.postMessage('[LOG] 🎯 [Fetch] 捕获: ' + url);\r\n                window.chrome.webview.postMessage('[LOG] [Fetch] 请求详情 - Method: ' + (args[1]?.method || 'GET'));\r\n                try {\r\n                    const response = await originalFetch(...args);\r\n                    const clone = response.clone();\r\n                    const reader = clone.body.getReader();\r\n                    const decoder = new TextDecoder();\r\n                    (async () => {\r\n                        try {\r\n                            while (true) {\r\n                                const { done, value } = await reader.read();\r\n                                if (done) { \r\n                                    window.chrome.webview.postMessage('[NETWORK_DONE]'); \r\n                                    break; \r\n                                }\r\n                                const text = decoder.decode(value, {stream: true});\r\n                                window.chrome.webview.postMessage('[NETWORK_DATA]' + text);\r\n                            }\r\n                        } catch (e) { \r\n                            window.chrome.webview.postMessage('[LOG] ❌ Fetch Stream Error: + e); \r\n                        }\r\n                    })();\r\n                    return response;\r\n                } catch (e) { \r\n                    window.chrome.webview.postMessage('[LOG] ❌ Fetch Exec Error: + e); \r\n                    return originalFetch(...args); \r\n                }\r\n            }\r\n            return originalFetch(...args);\r\n        };\r\n        \r\n        const OriginalXHR = window.XMLHttpRequest;\r\n        window.XMLHttpRequest = function() {\r\n            const xhr = new OriginalXHR();\r\n            let url = '';\r\n            const originalOpen = xhr.open;\r\n            xhr.open = function(method, requestUrl) {\r\n                url = requestUrl || '';\r\n                const isTongyiRequest = url.indexOf('tongyi.aliyun.com') !== -1;\r\n                const isApiPath = url.indexOf('/api/') !== -1 || url.indexOf('/chat') !== -1 || url.indexOf('/qianwen/') !== -1;\r\n                const isRelativeApi = url.startsWith('/api/') || url.startsWith('/chat/') || url.startsWith('/qianwen/');\r\n                const isStaticResource = url.match(/\\.(js|css|png|jpg|jpeg|gif|svg|woff|woff2|ttf|ico)$/);\r\n                \r\n                // 拦截阿里通义千问域名下的 API 请求，或相对路径的 API 请求\r\n                const shouldIntercept = !isStaticResource && (\r\n                    (isTongyiRequest && isApiPath) ||\r\n                    isRelativeApi\r\n                );\r\n                \r\n                if (shouldIntercept) { \r\n                    window.chrome.webview.postMessage('[LOG] 🎯 [XHR] 捕获: ' + url); \r\n                    window.chrome.webview.postMessage('[LOG] [XHR] 请求详情 - Method: ' + method);\r\n                }\r\n                return originalOpen.apply(this, arguments);\r\n            };\r\n            \r\n            xhr.addEventListener('progress', function() {\r\n                const isTongyiRequest = url.indexOf('tongyi.aliyun.com') !== -1;\r\n                const isApiPath = url.indexOf('/api/') !== -1 || url.indexOf('/chat') !== -1 || url.indexOf('/qianwen/') !== -1;\r\n                const isRelativeApi = url.startsWith('/api/') || url.startsWith('/chat/') || url.startsWith('/qianwen/');\r\n                const isStaticResource = url.match(/\\.(js|css|png|jpg|jpeg|gif|svg|woff|woff2|ttf|ico)$/);\r\n                const shouldIntercept = !isStaticResource && (\r\n                    (isTongyiRequest && isApiPath) ||\r\n                    isRelativeApi\r\n                );\r\n                \r\n                if (shouldIntercept) {\r\n                    try {\r\n                        let fullText = '';\r\n                        try { fullText = xhr.responseText; } catch(e) { return; }\r\n                        if (!fullText) return;\r\n                        const lastLen = xhr._lastLength || 0;\r\n                        const newChunk = fullText.substring(lastLen);\r\n                        if (newChunk.length > 0) {\r\n                            window.chrome.webview.postMessage('[NETWORK_DATA]' + newChunk);\r\n                            xhr._lastLength = fullText.length;\r\n                        }\r\n                    } catch(e) { \r\n                        window.chrome.webview.postMessage('[LOG] ❌ XHR Progress Error: + e); \r\n                    }\r\n                }\r\n            });\r\n            \r\n            xhr.addEventListener('load', function() { \r\n                const isTongyiRequest = url.indexOf('tongyi.aliyun.com') !== -1;\r\n                const isApiPath = url.indexOf('/api/') !== -1 || url.indexOf('/chat') !== -1 || url.indexOf('/qianwen/') !== -1;\r\n                const isRelativeApi = url.startsWith('/api/') || url.startsWith('/chat/') || url.startsWith('/qianwen/');\r\n                const isStaticResource = url.match(/\\.(js|css|png|jpg|jpeg|gif|svg|woff2|ttf|ico)$/);\r\n                const shouldIntercept = !isStaticResource && (\r\n                    (isTongyiRequest && isApiPath) ||\r\n                    isRelativeApi\r\n                );\r\n                if (shouldIntercept) { \r\n                    window.chrome.webview.postMessage('[NETWORK_DONE]'); \r\n                } \r\n            });\r\n            \r\n            return xhr;\r\n        };\r\n        \r\n        // V18新增：EventSource 拦截器\r\n        const OriginalEventSource = window.EventSource;\r\n        window.EventSource = function(url, config) {\r\n            window.chrome.webview.postMessage('[LOG] 🎯 [EventSource] 捕获: ' + url);\r\n            const es = new OriginalEventSource(url, config);\r\n            \r\n            es.addEventListener('message', function(event) {\r\n                window.chrome.webview.postMessage('[NETWORK_DATA]event:message\\\\ndata:' + event.data + '\\\\n\\\\n');\r\n            });\r\n            \r\n            es.addEventListener('error', function(e) {\r\n                window.chrome.webview.postMessage('[LOG] ❌ EventSource Error');\r\n                window.chrome.webview.postMessage('[NETWORK_DONE]');\r\n            });\r\n            \r\n            // 拦截所有自定义事件\r\n            const originalAddEventListener = es.addEventListener;\r\n            es.addEventListener = function(type, listener, options) {\r\n                if (type !== 'error' && type !== 'open' && type !== 'message') {\r\n                    window.chrome.webview.postMessage('[LOG] 🔔 EventSource 自定义事件: ' + type);\r\n                    const wrappedListener = function(event) {\r\n                        window.chrome.webview.postMessage('[NETWORK_DATA]event:' + type + '\\\\ndata:' + event.data + '\\\\n\\\\n');\r\n                        return listener.apply(this, arguments);\r\n                    };\r\n                    return originalAddEventListener.call(this, type, wrappedListener, options);\r\n                }\r\n                return originalAddEventListener.call(this, type, listener, options);\r\n            };\r\n            \r\n            return es;\r\n        };\r\n        \r\n        window.chrome.webview.postMessage('[LOG] ✅ 网络拦截器挂载完成 (Fetch + XHR + EventSource)');\r\n        \";\r\n    }\r\n\r\n    private string GetDomControlScript()\r\n    {\r\n        return @\"\r\n        window.chrome.webview.postMessage('[LOG] 🔧 正在创建 TongyiBridge (V22.6)...');\r\n        \r\n        window.TongyiBridge = {\r\n            sendPrompt: function(text) {\r\n                window.chrome.webview.postMessage('[LOG] 📝 收到发送请求，内容长度: ' + text.length);\r\n                window.chrome.webview.postMessage('[LOG] [sendPrompt] 开始执行 sendPrompt 函数');\r\n                \r\n                // 轮询等待输入框出现\r\n                let attempts = 0;\r\n                const maxAttempts = 30; // 最多尝试30次，共15秒\r\n                \r\n                const tryFindInput = () => {\r\n                    attempts++;\r\n                    window.chrome.webview.postMessage('[LOG] 🔍 尝试查找输入框 (' + attempts + '/' + maxAttempts + ')...');\r\n                    \r\n                    // 阿里通义千问的输入框选择器\r\n                    let input = document.querySelector('[contenteditable=\"\"true\"\"]') || \r\n                               document.querySelector('textarea[placeholder*=\"\"输入\"\"]') || \r\n                               document.querySelector('textarea[placeholder*=\"\"说点什么\"\"]') ||\r\n                               document.querySelector('textarea[placeholder*=\"\"message\"\"]') || \r\n                               document.querySelector('textarea') ||\r\n                               document.querySelector('.input-area') ||\r\n                               document.querySelector('.chat-input') ||\r\n                               document.querySelector('#chat-input') ||\r\n                               document.querySelector('div[contenteditable=\"\"true\"\"]') ||\r\n                               document.querySelector('.chat-input textarea') ||\r\n                               document.querySelector('.input-box textarea');\r\n                    \r\n                    if (!input) {\r\n                        if (attempts < maxAttempts) {\r\n                            window.chrome.webview.postMessage('[LOG] ⏳ 输入框未找到，500ms后重试...');\r\n                            setTimeout(tryFindInput, 500);\r\n                            return;\r\n                        } else {\r\n                            window.chrome.webview.postMessage('[LOG] ❌ 错误: 找不到输入框，已尝试 ' + maxAttempts + ' 次'); \r\n                            return;\r\n                        }\r\n                    }\r\n                    \r\n                    window.chrome.webview.postMessage('[LOG] ✅ 找到输入框: ' + input.tagName + ' class: ' + input.className);\r\n                \r\n                    // 聚焦输入框\r\n                    input.focus();\r\n                    window.chrome.webview.postMessage('[LOG] ✅ 输入框已聚焦');\r\n                    \r\n                    // 模拟真实用户行为 - 鼠标移动\r\n                    const rect = input.getBoundingClientRect();\r\n                    const mouseMoveEvent = new MouseEvent('mousemove', {\r\n                        clientX: rect.left + rect.width / 2,\r\n                        clientY: rect.top + rect.height / 2,\r\n                        bubbles: true\r\n                    });\r\n                    input.dispatchEvent(mouseMoveEvent);\r\n                    \r\n                    // 模拟鼠标点击\r\n                    const mouseDownEvent = new MouseEvent('mousedown', {\r\n                        clientX: rect.left + rect.width / 2,\r\n                        clientY: rect.top + rect.height / 2,\r\n                        bubbles: true\r\n                    });\r\n                    input.dispatchEvent(mouseDownEvent);\r\n                    \r\n                    const mouseUpEvent = new MouseEvent('mouseup', {\r\n                        clientX: rect.left + rect.width / 2,\r\n                        clientY: rect.top + rect.height / 2,\r\n                        bubbles: true\r\n                    });\r\n                    input.dispatchEvent(mouseUpEvent);\r\n                    \r\n                    const clickEvent = new MouseEvent('click', {\r\n                        clientX: rect.left + rect.width / 2,\r\n                        clientY: rect.top + rect.height / 2,\r\n                        bubbles: true,\r\n                        cancelable: true\r\n                    });\r\n                    input.dispatchEvent(clickEvent);\r\n                    \r\n                    // 清空输入框\r\n                    if (input.getAttribute('contenteditable') === 'true') {\r\n                        input.innerHTML = '';\r\n                    } else {\r\n                        input.value = '';\r\n                    }\r\n                    \r\n                    // ✅ 【关键】触发完整的输入事件序列\r\n                    const beforeInputEvent = new InputEvent('beforeinput', {\r\n                        bubbles: true,\r\n                        cancelable: true,\r\n                        inputType: 'deleteContentBackward'\r\n                    });\r\n                    input.dispatchEvent(beforeInputEvent);\r\n                    \r\n                    // 模拟输入法事件序列\r\n                    window.chrome.webview.postMessage('[LOG] 🎯 开始模拟输入法输入...');\r\n                    \r\n                    // 触发compositionstart事件\r\n                    const compositionStartEvent = new CompositionEvent('compositionstart', {\r\n                        data: '',\r\n                        bubbles: true,\r\n                        cancelable: true\r\n                    });\r\n                    input.dispatchEvent(compositionStartEvent);\r\n                    \r\n                    // 逐字输入，模拟真实输入速度\r\n                    let currentIndex = 0;\r\n                    const typeNextChar = () => {\r\n                        if (currentIndex < text.length) {\r\n                            const char = text[currentIndex];\r\n                            \r\n                            // 模拟compositionupdate事件\r\n                            const compositionUpdateEvent = new CompositionEvent('compositionupdate', {\r\n                                data: char,\r\n                                bubbles: true,\r\n                                cancelable: true\r\n                            });\r\n                            input.dispatchEvent(compositionUpdateEvent);\r\n                            \r\n                            // 实际设置内容\r\n                            if (input.getAttribute('contenteditable') === 'true') {\r\n                                input.innerHTML += char;\r\n                            } else {\r\n                                input.value += char;\r\n                            }\r\n                            \r\n                            // 触发input事件\r\n                            const inputEvent = new InputEvent('input', {\r\n                                bubbles: true,\r\n                                cancelable: true,\r\n                                inputType: 'insertText',\r\n                                data: char\r\n                            });\r\n                            input.dispatchEvent(inputEvent);\r\n                            \r\n                            // 随机延迟，模拟真实输入速度\r\n                            const delay = Math.random() * 50 + 20; // 20-70ms\r\n                            currentIndex++;\r\n                            setTimeout(typeNextChar, delay);\r\n                        } else {\r\n                            // 触发compositionend事件\r\n                            const compositionEndEvent = new CompositionEvent('compositionend', {\r\n                                data: text,\r\n                                bubbles: true,\r\n                                cancelable: true\r\n                            });\r\n                            input.dispatchEvent(compositionEndEvent);\r\n                            \r\n                            // 触发change事件\r\n                            const changeEvent = new Event('change', {\r\n                                bubbles: true,\r\n                                cancelable: true\r\n                            });\r\n                            input.dispatchEvent(changeEvent);\r\n                            \r\n                            // 触发focus事件\r\n                            const focusEvent = new FocusEvent('focus', {\r\n                                bubbles: true,\r\n                                cancelable: true\r\n                            });\r\n                            input.dispatchEvent(focusEvent);\r\n                            \r\n                            window.chrome.webview.postMessage('[LOG] ✅ 输入法模拟完成');\r\n                            \r\n                            // 等待一段时间后尝试发送\r\n                            setTimeout(() => {\r\n                                // 尝试发送：先按回车\r\n                                window.chrome.webview.postMessage('[LOG] 🎯 尝试：模拟回车发送');\r\n                                \r\n                                // 模拟按下 Enter 键（触发发送的关键）\r\n                                const enterKeyDown = new KeyboardEvent('keydown', {\r\n                                    key: 'Enter',\r\n                                    code: 'Enter',\r\n                                    keyCode: 13,\r\n                                    bubbles: true,\r\n                                    cancelable: true,\r\n                                    isComposing: false\r\n                                });\r\n                                \r\n                                const enterKeyPress = new KeyboardEvent('keypress', {\r\n                                    key: 'Enter',\r\n                                    code: 'Enter',\r\n                                    keyCode: 13,\r\n                                    bubbles: true,\r\n                                    cancelable: true,\r\n                                    isComposing: false\r\n                                });\r\n                                \r\n                                const enterKeyUp = new KeyboardEvent('keyup', {\r\n                                    key: 'Enter',\r\n                                    code: 'Enter',\r\n                                    keyCode: 13,\r\n                                    bubbles: true,\r\n                                    cancelable: true,\r\n                                    isComposing: false\r\n                                });\r\n                                \r\n                                // 按顺序触发事件\r\n                                if (input.dispatchEvent(enterKeyDown)) {\r\n                                    input.dispatchEvent(enterKeyPress);\r\n                                    input.dispatchEvent(enterKeyUp);\r\n                                    \r\n                                    window.chrome.webview.postMessage('[LOG] ✅ Enter 键事件已触发，等待自动发送...');\r\n                                    \r\n                                    // 如果 Enter 键没有触发发送，再尝试查找按钮\r\n                                    setTimeout(() => {\r\n                                        window.chrome.webview.postMessage('[LOG] 🔍 检查是否需要手动点击发送按钮...');\r\n                                        \r\n                                        // 查找发送按钮并点击\r\n                                        let sendButton = document.querySelector('button[type=\"\"submit\"\"]') ||\r\n                                                        document.querySelector('.send-button') ||\r\n                                                        document.querySelector('.submit-button') ||\r\n                                                        document.querySelector('#send-button') ||\r\n                                                        document.querySelector('button.send') ||\r\n                                                        document.querySelector('.send-btn') ||\r\n                                                        document.querySelector('[class*=\"\"send\"\"]') ||\r\n                                                        document.querySelector('[aria-label*=\"\"发送\"\"]') ||\r\n                                                        document.querySelector('button[class*=\"\"btn\"\"]') ||\r\n                                                        document.querySelector('.icon-send') ||\r\n                                                        document.querySelector('[class*=\"\"submit\"\"]') ||\r\n                                                        document.querySelector('button:has(svg)') ||\r\n                                                        document.querySelector('button[class*=\"\"icon\"\"]') ||\r\n                                                        document.querySelector('[class*=\"\"send\"\"].icon') ||\r\n                                                        document.querySelector('button[aria-label*=\"\"发送\"\"]') ||\r\n                                                        document.querySelector('button[class*=\"\"send\"\"].button') ||\r\n                                                        document.querySelector('button[disabled=\"\"false\"\"]') || // 查找未禁用的按钮\r\n                                                        document.querySelector('button:not([disabled])'); // 查找未被禁用的按钮\r\n                                                        \r\n                                        // 如果还是没找到，尝试通过文本内容查找\r\n                                        if (!sendButton) {\r\n                                            window.chrome.webview.postMessage('[LOG] 🔍 通过文本内容查找按钮...');\r\n                                            const buttons = document.querySelectorAll('button');\r\n                                            window.chrome.webview.postMessage('[LOG] 找到 ' + buttons.length + ' 个按钮元素');\r\n                                            for (let btn of buttons) {\r\n                                                if (btn.textContent && (btn.textContent.includes('发送') || btn.textContent.includes('Send') || btn.textContent.includes('send'))) {\r\n                                                    sendButton = btn;\r\n                                                    window.chrome.webview.postMessage('[LOG] ✅ 找到发送按钮: ' + btn.textContent);\r\n                                                    break;\r\n                                                }\r\n                                            }\r\n                                        }\r\n                                        \r\n                                        // 如果还是没找到，尝试查找所有可能的发送按钮\r\n                                        if (!sendButton) {\r\n                                            window.chrome.webview.postMessage('[LOG] 🔍 尝试查找所有可能的发送按钮...');\r\n                                            const possibleButtons = document.querySelectorAll('button');\r\n                                            for (let btn of possibleButtons) {\r\n                                                // 检查按钮是否有图标或发送相关类名\r\n                                                const hasSvg = btn.querySelector('svg');\r\n                                                const hasIcon = btn.querySelector('i') || btn.querySelector('.icon');\r\n                                                const hasSendClass = btn.className.toLowerCase().includes('send') || btn.className.toLowerCase().includes('submit');\r\n                                                const hasSendRole = btn.getAttribute('role') === 'button' && btn.innerHTML.toLowerCase().includes('send');\r\n                                                \r\n                                                if (hasSvg || hasIcon || hasSendClass || hasSendRole) {\r\n                                                    sendButton = btn;\r\n                                                    window.chrome.webview.postMessage('[LOG] ✅ 找到可能的发送按钮: ' + btn.className);\r\n                                                    break;\r\n                                                }\r\n                                            }\r\n                                        }\r\n                                        \r\n                                        if (sendButton) {\r\n                                            window.chrome.webview.postMessage('[LOG] ✅ 找到发送按钮: ' + sendButton.tagName + ' class: ' + sendButton.className);\r\n                                            \r\n                                            // 检查按钮是否被禁用\r\n                                            if (sendButton.disabled) {\r\n                                                window.chrome.webview.postMessage('[LOG] ⚠️ 发送按钮当前被禁用，尝试强制启用...');\r\n                                                sendButton.disabled = false;\r\n                                                sendButton.setAttribute('disabled', false);\r\n                                                sendButton.classList.remove('disabled');\r\n                                            }\r\n                                            \r\n                                            // 模拟鼠标移动到按钮\r\n                                            const buttonRect = sendButton.getBoundingClientRect();\r\n                                            const buttonMoveEvent = new MouseEvent('mousemove', {\r\n                                                clientX: buttonRect.left + buttonRect.width / 2,\r\n                                                clientY: buttonRect.top + buttonRect.height / 2,\r\n                                                bubbles: true\r\n                                            });\r\n                                            sendButton.dispatchEvent(buttonMoveEvent);\r\n                                            \r\n                                            // 模拟鼠标按下\r\n                                            const buttonDownEvent = new MouseEvent('mousedown', {\r\n                                                clientX: buttonRect.left + buttonRect.width / 2,\r\n                                                clientY: buttonRect.top + buttonRect.height / 2,\r\n                                                bubbles: true\r\n                                            });\r\n                                            sendButton.dispatchEvent(buttonDownEvent);\r\n                                            \r\n                                            // 模拟鼠标松开\r\n                                            const buttonUpEvent = new MouseEvent('mouseup', {\r\n                                                clientX: buttonRect.left + buttonRect.width / 2,\r\n                                                clientY: buttonRect.top + buttonRect.height / 2,\r\n                                                bubbles: true\r\n                                            });\r\n                                            sendButton.dispatchEvent(buttonUpEvent);\r\n                                            \r\n                                            // 模拟点击\r\n                                            const buttonClickEvent = new MouseEvent('click', {\r\n                                                clientX: buttonRect.left + buttonRect.width / 2,\r\n                                                clientY: buttonRect.top + buttonRect.height / 2,\r\n                                                bubbles: true,\r\n                                                cancelable: true\r\n                                            });\r\n                                            sendButton.dispatchEvent(buttonClickEvent);\r\n                                            \r\n                                            // 再次尝试触发 Enter 键（双重保险）\r\n                                            input.dispatchEvent(enterKeyDown);\r\n                                            input.dispatchEvent(enterKeyPress);\r\n                                            input.dispatchEvent(enterKeyUp);\r\n                                            \r\n                                            window.chrome.webview.postMessage('[LOG] 🖱️ 尝试点击发送按钮并再次触发Enter键');\r\n                                        } else {\r\n                                            window.chrome.webview.postMessage('[LOG] ❌ 未找到发送按钮，但已触发Enter键');\r\n                                        }\r\n                                    }, 1000); // 等待1秒后检查按钮\r\n                                } else {\r\n                                    window.chrome.webview.postMessage('[LOG] ⚠️ Enter 键被阻止，尝试按钮点击...');\r\n                                    \r\n                                    // 如果 Enter 键未生效，则继续寻找发送按钮\r\n                                    setTimeout(() => {\r\n                                        let sendButton = document.querySelector('button[type=\"\"submit\"\"]') ||\r\n                                                        document.querySelector('.send-button') ||\r\n                                                        document.querySelector('.submit-button') ||\r\n                                                        document.querySelector('#send-button') ||\r\n                                                        document.querySelector('button.send') ||\r\n                                                        document.querySelector('.send-btn') ||\r\n                                                        document.querySelector('[class*=\"\"send\"\"]') ||\r\n                                                        document.querySelector('[aria-label*=\"\"发送\"\"]') ||\r\n                                                        document.querySelector('button:not([disabled])');\r\n                                                        \r\n                                        if (sendButton) {\r\n                                            sendButton.disabled = false; // 强制启用\r\n                                            sendButton.click();\r\n                                            window.chrome.webview.postMessage('[LOG] 🖱️ 尝试点击发送按钮（备用方案）');\r\n                                        } else {\r\n                                            window.chrome.webview.postMessage('[LOG] ❌ 未找到发送按钮');\r\n                                        }\r\n                                    }, 500);\r\n                                }\r\n                            }, 1000);\r\n                        }\r\n                    };\r\n                    \r\n                    // 开始逐字输入\r\n                    typeNextChar();\r\n                };\r\n                \r\n                // 开始尝试查找输入框\r\n                tryFindInput();\r\n            }\r\n        };\r\n        \r\n        window.chrome.webview.postMessage('[LOG] ✅ TongyiBridge 创建完成 (V22.6)');\r\n        \";\r\n    }\r\n}"
        },
